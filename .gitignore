/target
.claude/*
!.claude/settings.json
/yak_linux_amd64
/.cargo-home
.xwin-cache/
# prping web 前端：node_modules 与构建产物不入库（dist 由 build.rs/just build-web 生成，仅保留占位目录）
frontend/node_modules/
frontend/dist/*
!frontend/dist/.gitkeep
# target/<profile>/UI（just build/build-release 同步的前端产物）已由 /target 覆盖

# npm/playwright 本地缓存与临时工具目录（误生成不入库）
.npm-cache/
.pw-test/

# just dotenv 本地配置（set dotenv-load；不提交）
.env

# 测试循环现场（.test-loop/：每轮验证沙箱——截图/探针脚本/日志/二进制拷贝一律不入库；
# 有留存价值的最终截图/结论文档收尾挑拣拷贝进 .uiaudit/ 留档）
.test-loop/

