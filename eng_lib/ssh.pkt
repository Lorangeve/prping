# eng_lib/ssh.pkt —— SSH 协议定义（RFC 4251-4254）
#
# SSH (Secure Shell) 是安全远程登录协议，提供加密的命令行访问和文件传输。
# 本文件定义 SSH 协议的消息结构，用于学习和调试 SSH 连接。
#
# SSH 协议分为三层：
#   1. 传输层：负责密钥交换、服务器认证、数据完整性
#   2. 认证层：负责用户认证（密码、公钥等）
#   3. 连接层：负责多路复用（会话、端口转发、SFTP 等）
#
# 注意：本定义仅用于协议学习和调试，不实现完整的 SSH 栈。

# SSH 二进制数据包（RFC 4253 §6）
# ── SSH 数据包结构 ──────────────────────────────────────────────────────────
# SSH 使用二进制数据包传输消息，包含：
#   - 包长度（4B）：后续数据的长度（不含 MAC）
#   - 填充长度（1B）：填充字节的长度
#   - 载荷：实际消息内容
#   - 填充：随机填充字节（使包长度为密码块大小的倍数）
#   - MAC：消息认证码（可选，在加密后计算）
# ───────────────────────────────────────────────────────────────────────────────
# @param packet_length: 包长度（4字节，大端序）
#                       不含 MAC 和自身，包含 padding_length + payload + padding
#                       最小值：12 字节（无载荷）
#                       最大值：35000 字节（RFC 推荐）
# @param padding_length: 填充长度（1字节）
#                        填充字节的长度，最小 4 字节
#                        使包长度为密码块大小的倍数
# @param payload: 载荷数据（变长）
#                 实际的 SSH 消息（消息类型 + 消息数据）
#                 第一个字节是消息类型
# @param padding: 填充字节（变长，padding_length 字节）
#                 随机字节，不包含任何有意义的信息
#                 用于防止流量分析和对齐密码块
# @param mac: 消息认证码（可选，变长）
#             用于验证数据完整性
#             在加密模式下计算，明文模式下为空
# @auto: packet_length 自动计算
#[proto(kind="ssh")]
func ssh_packet(payload="", padding="") -> bytes {
    concat(
        #[meta(len="auto")] be32(packet_length),    # 包长度：4字节（自动计算）
        u8(count(padding)),                          # 填充长度：1字节
        payload,                                     # 载荷：变长
        padding                                      # 填充：变长
    )
}

# SSH 密钥交换初始化（RFC 4253 §7.1）
# ── SSH 密钥交换结构 ────────────────────────────────────────────────────────
# SSH 连接建立时，双方交换支持的算法列表：
#   - 协议版本：SSH 协议版本字符串
#   - 软件版本：SSH 实现的软件版本
#   - 评论：可选的注释信息
# ───────────────────────────────────────────────────────────────────────────────
# @param protocol_version: 协议版本字符串
#                          格式："SSH-2.0-softwareversion"
#                          SSH-2.0 表示 SSH 协议版本 2.0
#                          softwareversion 是 SSH 实现的版本
# @param software_version: 软件版本字符串
#                          通常包含实现名称和版本号
#                          如 "OpenSSH_8.9p1 Ubuntu-3ubuntu0.1"
# @param comments: 注释字符串（可选）
#                  通常为空或包含服务器信息
# @auto: 无自动字段（版本协商是明文传输）
#[proto]
func ssh_version(protocol_version="SSH-2.0", software_version="", comments="") -> bytes {
    concat(
        line(protocol_version),             # 协议版本：文本行
        line(software_version),             # 软件版本：文本行
        line(comments)                      # 注释：文本行
    )
}

# SSH 密钥交换初始化消息（RFC 4253 §7.1）
# ── SSH 密钥交换初始化结构 ──────────────────────────────────────────────────
# 密钥交换开始时，双方发送支持的算法列表：
#   - Cookie：16 字节随机数（防止 IP 欺骗）
#   - 算法列表：支持的各种算法（密钥交换、服务器主机密钥、加密、MAC、压缩）
# ───────────────────────────────────────────────────────────────────────────────
# @param cookie: 16 字节随机数（Cookie）
#                用于防止 IP 欺骗攻击
#                每次连接都应生成新的随机 Cookie
# @param kex_algorithms: 密钥交换算法列表（逗号分隔）
#                        常见算法：
#                        - diffie-hellman-group14-sha256
#                        - diffie-hellman-group16-sha512
#                        - ecdh-sha2-nistp256
#                        - curve25519-sha256
# @param server_host_key_algorithms: 服务器主机密钥算法列表（逗号分隔）
#                                    常见算法：
#                                    - ssh-rsa
#                                    - ssh-ed25519
#                                    - ecdsa-sha2-nistp256
# @param encryption_algorithms_client_to_server: 客户端到服务器加密算法列表（逗号分隔）
#                                                常见算法：
#                                                - aes128-ctr
#                                                - aes256-ctr
#                                                - chacha20-poly1305
# @param encryption_algorithms_server_to_client: 服务器到客户端加密算法列表（逗号分隔）
# @param mac_algorithms_client_to_server: 客户端到服务器 MAC 算法列表（逗号分隔）
#                                         常见算法：
#                                         - hmac-sha2-256
#                                         - hmac-sha2-512
#                                         - hmac-sha1
# @param mac_algorithms_server_to_client: 服务器到客户端 MAC 算法列表（逗号分隔）
# @param compression_algorithms_client_to_server: 客户端到服务器压缩算法列表（逗号分隔）
#                                                 常见算法：
#                                                 - none（无压缩）
#                                                 - zlib
# @param compression_algorithms_server_to_client: 服务器到客户端压缩算法列表（逗号分隔）
# @param languages_client_to_server: 客户端到服务器语言列表（逗号分隔，可选）
# @param languages_server_to_client: 服务器到客户端语言列表（逗号分隔，可选）
# @param first_kex_packet_follows: 是否有第一个密钥交换包跟随（1字节布尔值）
#                                   0 = 无，1 = 有
# @param reserved: 保留字段（4字节，必须为 0）
# @auto: 无自动字段
#[proto]
func ssh_kexinit(cookie="", kex_algorithms="", server_host_key_algorithms="", encryption_algorithms_client_to_server="", encryption_algorithms_server_to_client="", mac_algorithms_client_to_server="", mac_algorithms_server_to_client="", compression_algorithms_client_to_server="", compression_algorithms_server_to_client="", languages_client_to_server="", languages_server_to_client="", first_kex_packet_follows=0, reserved=0) -> bytes {
    concat(
        cookie,                                             # Cookie：16字节随机数
        #[meta(len="kex_algorithms")] be32(kex_algorithms_len),  # 密钥交换算法列表长度：4字节
        kex_algorithms,                                     # 密钥交换算法列表：变长
        #[meta(len="server_host_key_algorithms")] be32(server_host_key_algorithms_len),  # 服务器主机密钥算法列表长度：4字节
        server_host_key_algorithms,                         # 服务器主机密钥算法列表：变长
        #[meta(len="encryption_algorithms_client_to_server")] be32(encryption_algorithms_client_to_server_len),  # 客户端到服务器加密算法列表长度：4字节
        encryption_algorithms_client_to_server,             # 客户端到服务器加密算法列表：变长
        #[meta(len="encryption_algorithms_server_to_client")] be32(encryption_algorithms_server_to_client_len),  # 服务器到客户端加密算法列表长度：4字节
        encryption_algorithms_server_to_client,             # 服务器到客户端加密算法列表：变长
        #[meta(len="mac_algorithms_client_to_server")] be32(mac_algorithms_client_to_server_len),  # 客户端到服务器 MAC 算法列表长度：4字节
        mac_algorithms_client_to_server,                    # 客户端到服务器 MAC 算法列表：变长
        #[meta(len="mac_algorithms_server_to_client")] be32(mac_algorithms_server_to_client_len),  # 服务器到客户端 MAC 算法列表长度：4字节
        mac_algorithms_server_to_client,                    # 服务器到客户端 MAC 算法列表：变长
        #[meta(len="compression_algorithms_client_to_server")] be32(compression_algorithms_client_to_server_len),  # 客户端到服务器压缩算法列表长度：4字节
        compression_algorithms_client_to_server,            # 客户端到服务器压缩算法列表：变长
        #[meta(len="compression_algorithms_server_to_client")] be32(compression_algorithms_server_to_client_len),  # 服务器到客户端压缩算法列表长度：4字节
        compression_algorithms_server_to_client,            # 服务器到客户端压缩算法列表：变长
        #[meta(len="languages_client_to_server")] be32(languages_client_to_server_len),  # 客户端到服务器语言列表长度：4字节
        languages_client_to_server,                         # 客户端到服务器语言列表：变长
        #[meta(len="languages_server_to_client")] be32(languages_server_to_client_len),  # 服务器到客户端语言列表长度：4字节
        languages_server_to_client,                         # 服务器到客户端语言列表：变长
        u8(first_kex_packet_follows),                       # 是否有第一个密钥交换包跟随：1字节
        be32(reserved)                                      # 保留字段：4字节
    )
}

# SSH 认证请求（RFC 4252 §5）
# ── SSH 认证请求结构 ────────────────────────────────────────────────────────
# 用户认证请求，包含认证方法和凭据：
#   - 用户名：要认证的用户名
#   - 服务名：要访问的服务（通常是 "ssh-connection"）
#   - 方法名：认证方法（password, publickey 等）
# ───────────────────────────────────────────────────────────────────────────────
# @param user_name: 用户名（字符串）
#                   要认证的用户名
# @param service_name: 服务名（字符串）
#                      通常为 "ssh-connection"
# @param method_name: 认证方法（字符串）
#                     常见方法：
#                     - password：密码认证
#                     - publickey：公钥认证
#                     - keyboard-interactive：交互式认证
#                     - hostbased：基于主机的认证
# @param password: 密码（仅 password 方法，可选）
#                  用户的密码
# @auto: 无自动字段
#[proto]
func ssh_auth_request(user_name="root", service_name="ssh-connection", method_name="password", password="") -> bytes {
    concat(
        string(user_name),                  # 用户名：字符串
        string(service_name),               # 服务名：字符串
        string(method_name),                # 认证方法：字符串
        string(password)                    # 密码：字符串（仅 password 方法）
    )
}

# SSH 通道打开请求（RFC 4254 §5.1）
# ── SSH 通道打开结构 ────────────────────────────────────────────────────────
# 请求打开一个新的通道：
#   - 通道类型：session, direct-tcpip, forwarded-tcpip 等
#   - 发送方通道：本端的通道号
#   - 初始窗口大小：接收窗口大小
#   - 最大包大小：单个数据包的最大大小
# ───────────────────────────────────────────────────────────────────────────────
# @param channel_type: 通道类型（字符串）
#                      常见类型：
#                      - session：交互式会话
#                      - direct-tcpip：直接 TCP 转发
#                      - forwarded-tcpip：远程端口转发
#                      - x11：X11 转发
# @param sender_channel: 发送方通道号（4字节，大端序）
#                        本端的通道标识符
# @param initial_window_size: 初始窗口大小（4字节，大端序）
#                             接收窗口大小（字节数）
#                             用于流量控制
# @param maximum_packet_size: 最大包大小（4字节，大端序）
#                             单个数据包的最大大小（字节数）
#                             通常 32768 字节
# @auto: 无自动字段
#[proto]
func ssh_channel_open(channel_type="session", sender_channel=0, initial_window_size=2097152, maximum_packet_size=32768) -> bytes {
    concat(
        string(channel_type),               # 通道类型：字符串
        be32(sender_channel),               # 发送方通道号：4字节
        be32(initial_window_size),          # 初始窗口大小：4字节
        be32(maximum_packet_size)           # 最大包大小：4字节
    )
}

# SSH 通道数据（RFC 4254 §5.2）
# ── SSH 通道数据结构 ────────────────────────────────────────────────────────
# 通过通道传输的数据：
#   - 接收方通道：对方的通道号
#   - 数据：要传输的数据
# ───────────────────────────────────────────────────────────────────────────────
# @param recipient_channel: 接收方通道号（4字节，大端序）
#                           对方的通道标识符
# @param data: 数据（变长）
#              要传输的实际数据
# @auto: 无自动字段
#[proto]
func ssh_channel_data(recipient_channel=0, data="") -> bytes {
    concat(
        be32(recipient_channel),            # 接收方通道号：4字节
        string(data)                        # 数据：字符串
    )
}

export:
- ssh_packet
- ssh_version
- ssh_kexinit
- ssh_auth_request
- ssh_channel_open
- ssh_channel_data
