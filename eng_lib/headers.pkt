# eng_lib/headers.pkt —— pkglang 标准库：层头构建函数（由 hex/raw + 字节原语拼出）
#
# 引擎只留 hex/raw（数据原语）与字节原语（concat/u8/be16/tpl/sum/...）；
# eth/ipv4/... 层头由这里用 func + 原语构建。这些函数与引擎内置同名，
# 库导出优先（作用域遮蔽内置）。
#
# 地址字节（ip4/ip6/mac）来自 eng_lib/bytes.pkt 的 tpl 值函数；src/dst 可域名——
# 值位置经 dns() 显式解析（IP 字面量短路，无需解析器），layer 的 src/dst 字段
# 位置仍由引擎自动域名回退（伪头部校验和元数据）。
#
# 自动字段：total_length / header checksum / TCP·UDP checksum 依赖载荷长度与伪头部，
# 函数内无法算——序列化时引擎按层类型自动补（`layer` 层标注原语，见 bytes.pkt）。
#
# 参数约定与内置一致：未给默认值 = 自动值（引擎补）；这里给出合理的默认。
#
# doc 注释约定同 net.pkt：摘要 + `@param`/`@auto` 标签行，`--eng --ls` 展示。

# ── 链路层 ─────────────────────────────────────────────────

# 14B 以太网头（自表示协议 proto）
# @param dst_mac: 目标 MAC；默认广播
# @param src_mac: 源 MAC；默认全零（raw 发送时网关不认，建议显式指定或随机）
# @param ethertype: 以太网类型；默认 0x0800（IPv4）
# @auto: ethertype 仍是默认占位 0x0800 而内层是 ARP/IPv6 时按内层推导（0x0806/0x86dd）
#[proto(kind="eth")]
func eth(dst_mac="ff:ff:ff:ff:ff:ff", src_mac="00:00:00:00:00:00", ethertype=0x0800) -> bytes {
    concat(mac(dst_mac), mac(src_mac), be16(ethertype))
}

# 28B ARP 头（htype=1 ptype=0x0800 hlen=6 plen=4；自表示协议 proto）
# @param op: 操作码：request()/reply()（位常量，见 bytes.pkt）或数字
# @param sha: 发送方硬件地址（源 MAC）
# @param spa: 发送方协议地址（源 IPv4；可域名）
# @param tha: 目标硬件地址（目标 MAC）
# @param tpa: 目标协议地址（目标 IPv4；可域名）
# @auto: 无自动字段（ARP 无校验和）
#[proto(kind="arp")]
func arp(htype=1, ptype=0x0800, hlen=6, plen=4, op=request(), sha="00:00:00:00:00:00", spa="0.0.0.0", tha="00:00:00:00:00:00", tpa="0.0.0.0") -> bytes {
    concat(
        be16(htype), be16(ptype), u8(hlen), u8(plen), be16(op),
        mac(sha), ip4(spa), mac(tha), ip4(tpa)
    )
}

# ── 网络层 ─────────────────────────────────────────────────

# 20B IPv4 头（+变长 options）；total_length 与 header checksum 由引擎自动补（len="auto"，序列化器覆盖）
# version/ihl 是同一字节的两个 4 位字段（bit 原语 `#[meta(bits=4)]`：声明顺序高位→低位，
# version(4)+ihl(4) = 首字节 0x45）——ihl 是独立可引用字段，options 宽度
# `bytes="sub(mul(ihl, 4), 20)"` 按它回算（带选项的头注册表也能解析）
# @param src: 源 IPv4 地址；默认 0.0.0.0（raw 发送时自动填本地地址；可域名）
# @param dst: 目标 IPv4 地址；默认广播；可域名
# @param version: IP 版本（高 4 位）
# @param ihl: 头长/4（低 4 位；= 5 + options/4）
# @param ttl: IP 生存时间
# @param proto: 内层协议号；省略按内层推导（icmp→1/tcp→6/udp→17）
# @param tos: 服务类型（Type of Service）
# @param id: IP 标识（分片用）
# @param flags: IP 标志：df()/mf() 或 bor(df(), mf())（位常量，默认无）
# @param options: 选项字节（长度需 = ihl*4 - 20；空 = 无选项）
# @auto: 自动补 total_length 与 header checksum；proto 占位 0 且内层 TCP/UDP/ICMP 时推导
#[proto(kind="ipv4")]
func ipv4(ihl=5, tos=0, proto=0, ttl=64, id=0, flags=0, options="", src="0.0.0.0", dst="255.255.255.255") -> bytes {
    concat(
        #[meta(name="version", bits=4)] u8(4),
        #[meta(name="ihl", bits=4)] u8(ihl),
        u8(tos),
        #[meta(len="auto")] be16(total),
        be16(id),
        be16(flags),
        u8(ttl),
        u8(proto),
        #[meta(len="auto")] be16(checksum),
        ip4(src), ip4(dst),
        #[meta(bytes="sub(mul(ihl, 4), 20)")] options
    )
}

# 40B IPv6 头；payload_length 由引擎自动补（len="auto"，序列化器覆盖）
# @param src: 源 IPv6 地址；默认 ::（raw 发送时自动填本地地址；可域名）
# @param dst: 目标 IPv6 地址；默认 ::；可域名
# @param hop_limit: 跳数限制
# @param next_header: 内层协议头类型；省略按内层推导（icmp→58/tcp→6/udp→17）
# @auto: 自动补 payload_length；next_header 占位 59 时按内层推导
#[proto(kind="ipv6")]
func ipv6(src="::", dst="::", hop_limit=64, next_header=59) -> bytes {
    concat(
        #[meta(name="first4")] hex("60000000"),
        #[meta(len="auto")] be16(plen),
        u8(next_header),
        u8(hop_limit),
        ip6(src), ip6(dst)
    )
}

# ICMP 头（+可选载荷）；checksum（offset 2-3）由引擎自动补（覆盖头+载荷；自表示 proto）
# @param type: ICMP 类型；默认 8（echo request）
# @param code: ICMP 代码
# @param id: 标识（echo 用；可 rand16()）
# @param seq: 序号（echo 用；可 rand16()）
# @param payload: 载荷字节（字符串或字节列表）
# @auto: 自动补 checksum（覆盖头+载荷）
#[proto(kind="icmp")]
func icmp(type=8, code=0, id=0, seq=0, payload="") -> bytes {
    concat(
        u8(type),
        u8(code),
        #[meta(len="auto")] be16(checksum),
        be16(id),
        be16(seq),
        #[meta(rest)] payload
    )
}

# ── 传输层 ─────────────────────────────────────────────────

# TCP 头（20B 定长 + 变长 options；自表示协议 proto）
# data_offset（byte 12 高 4 位）自动 = 5 + options/4（len="auto" + expr 变换，
# `len` = 后续字段字节数，含 options 自身——表达式按头长 20 折算）
# options 宽度 = (data_offset>>4)*4 - 20（解析侧按前序字段回算）
# checksum（offset 16-17，含外层 IP 伪头部）由引擎自动补（len="auto"，序列化器覆盖）
# @param sport: 源端口；默认随机
# @param dport: 目标端口
# @param seq: 序列号
# @param ack: 确认号
# @param flags: 标志位：syn()/ack()/bor(syn(), ack()) 等位常量组合（见 bytes.pkt；或数字）
# @param window: 窗口大小
# @param urg: 紧急指针（URG 标志时有效）
# @param options: 选项字节（TLV 序列，长度需 4 的倍数；空 = 无选项）
# @auto: 自动补 data_offset（5 + options/4，高 4 位）与 checksum（含外层 IP 伪头部）
#[proto(kind="tcp")]
func tcp(sport=rand16(), dport=0, seq=0, ack=0, flags=syn(), window=65535, urg=0, options="") -> bytes {
    concat(
        be16(sport), be16(dport), be32(seq), be32(ack),
        #[meta(name="data_offset", len="auto", expr="shl(div(len + 13, 4), 4)")] u8(bor(0x50, 0)),
        u8(flags), be16(window),
        #[meta(len="auto")] be16(checksum),
        #[meta(name="urg")] be16(urg),
        #[meta(bytes="sub(mul(shr(data_offset, 4), 4), 20)")] options
    )
}

# 8B UDP 头；length 与 checksum 引擎自动补（len="auto"，序列化器覆盖；自表示 proto）
# @param sport: 源端口；默认随机
# @param dport: 目标端口
# @auto: 自动补 length 与 checksum（含外层 IP 伪头部）
#[proto(kind="udp")]
func udp(sport=rand16(), dport=0) -> bytes {
    concat(
        be16(sport),
        be16(dport),
        #[meta(len="auto")] be16(length),
        #[meta(len="auto")] be16(checksum)
    )
}

# ── 应用层 ─────────────────────────────────────────────────

# HTTP/1.1 头行（rest(子proto) 重复区元素子 proto）：line 字段读一行到 \r\n；
# 解析侧空行（\r\n 开头）→ 解析失败 → 重复区停止（headers 区结束，body 由下一字段接）
# @param text: 一行文本（如 "Host: example.com"）
#[proto]
func hdr_line(text="") -> bytes {
    concat(line(text))
}

# HTTP/1.1 文本报文（自表示协议 proto）：start_line + headers（rest(hdr_line)
# 重复解析到空行）+ 空行（hex("0d0a") 常量校验）+ body（rest）；rule tcp 80/8080
# 分派（与旧 parse_http 端口一致）
# @param start_line: 请求行/状态行（如 "GET / HTTP/1.1" / "HTTP/1.1 200 OK"；默认 GET / HTTP/1.1）
# @param headers: 头行列表（如 ["Host: example.com"]）
# @param body: 报文体
# @auto: 原样字节，无自动字段
#[proto(kind="http")]
#[rule(or(tcp(dport=80), tcp(dport=8080)))]
func http(start_line="GET / HTTP/1.1", headers=[], body="") -> bytes {
    concat(
        line(start_line),
        #[meta(rest="hdr_line")] headers,
        hex("0d0a"),
        #[meta(rest)] body
    )
}

# DNS 查询记录（list 元素子 proto）：name（DNS 名字，DnsName 字段）+
# qtype/qclass 定宽
# @param name: 查询名字（如 "www.baidu.com"）
# @param qtype: 查询类型；默认 1（A）
# @param qclass: 查询类；默认 1（IN）
#[proto]
func dns_question(name="", qtype=1, qclass=1) -> bytes {
    concat(
        dns_name(name),
        be16(qtype), be16(qclass)
    )
}

# DNS 应答记录（list 元素子 proto）：name（压缩指针追跳还原）+ 定宽 +
# rdlen（count(rdata) 算）+ rdata（宽度按前序字段 rdlen 回算）
# @param name: 资源名（应答里常是压缩指针，追跳还原为点分名字）
# @param rtype: 记录类型；默认 1（A）
# @param class: 记录类；默认 1（IN）
# @param ttl: 缓存时间
# @param rdata: 记录数据（如 A 记录 4 字节 IP）
#[proto]
func dns_answer(name="", rtype=1, class=1, ttl=0, rdata="") -> bytes {
    concat(
        dns_name(name),
        be16(rtype), be16(class), be32(ttl),
        #[meta(name="rdlen")] be16(count(rdata)),
        #[meta(bytes="rdlen")] rdata
    )
}

# DNS 报文（头 12B + 问题区 + 应答/授权/附加区；自表示协议 proto，可构造可解析）
# questions/answers/authority/additional 为 list 重复字段（计数 = 各区 count）
# @param id: 事务 ID（应答匹配用；可 rand16()）
# @param flags: 标志位；默认 0x0100（RD）
# @param questions: 查询名字列表（如 ["www.baidu.com"]）
# @param answers: 应答记录列表（响应报文）
# @param authority: 授权记录列表
# @param additional: 附加记录列表
# @auto: 原样字节，无自动字段
#[proto(kind="dns")]
#[rule(udp(dport=53))]
#[rule(tcp(dport=53))]
func dns(id=0, flags=0x0100, questions=[], answers=[], authority=[], additional=[]) -> bytes {
    concat(
        be16(id), be16(flags),
        #[meta(name="qdcount")] be16(count(questions)),
        #[meta(name="ancount")] be16(count(answers)),
        #[meta(name="nscount")] be16(count(authority)),
        #[meta(name="arcount")] be16(count(additional)),
        #[meta(list="qdcount", item="dns_question")] questions,
        #[meta(list="ancount", item="dns_answer")] answers,
        #[meta(list="nscount", item="dns_answer")] authority,
        #[meta(list="arcount", item="dns_answer")] additional
    )
}

export:
- eth
- arp
- ipv4
- ipv6
- icmp
- tcp
- udp
- http
- dns
