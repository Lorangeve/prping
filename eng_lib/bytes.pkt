# eng_lib/bytes.pkt —— 层标注具名包装 + 字节构建值函数：
#   引擎 `layer(kind, bytes[, src, dst])` 的 9 个别名（*_bytes）；
#   字节原语组合出的通用值函数（rand_mac）+ tpl 模板实现的文本解析值函数
#   （ip4/ip6/mac 地址、dns_name 域名线格式）+ 位运算组合（cksum 校验和）
#   + 协议标志位常量（syn/df/request 等，组合用位运算原语 bor/band/bxor）。
#
# 引擎只留一个通用层标注原语 `layer`（字节 → 带类型层，kind 为闭集字面量）；
# 这里为每种层提供具名包装，供 headers.pkt 与用户脚本直接使用。
# 值位置：ip4/ip6/mac 由通用模板原语 `tpl` 实现（字面量文本解析下沉至此，
# 见 packet-dsl/src/tpl.rs）；dns_name 由 tpl `%L` 说明符实现；line 由
# concat∘raw + hex 换行实现（与 proto `line` 字段构造侧同源，双位置）；
# 域名需显式 `dns()`（ip4(dns("host"))），地址字段（layer 的 src/dst）仍由引擎自动解析域名。
# 协议标志位（TCP/IPv4 flags、ARP op）原为引擎原语 tcpflags/ip4flags/arpop，
# 已下沉为位常量值函数 + 位运算组合（tcp(flags=bor(syn(), ack()))）。
# count/cksum 为引擎原语（中间形态：算法原语化，语言最小化——无 lambda/map/filter/
# 多态折叠/reduce）；len 是可组合的库值函数（count∘raw，见下），md5/sha1/sha256
# 摘要原语在引擎侧，sum（无真实用户）与 reduce（已被 proto list/rest 取代）已移除。
#
# doc 注释约定同 net.pkt：摘要 + `@param`/`@auto` 标签行，`--eng --ls` 展示。

# 字节 → eth 层（14B 以太网头直喂）
# @param bytes: 该层完整头字节（hex("...") 或字节列表）
# @auto: 整层头用给定字节；仅 ethertype 仍是默认 0x0800 且内层为 ARP/IPv6 时按内层推导
func eth_bytes(bytes) { layer("eth", bytes) }

# 字节 → arp 层（28B ARP 头直喂）
# @param bytes: 该层完整头字节
# @auto: 整层头用给定字节，无自动字段
func arp_bytes(bytes) { layer("arp", bytes) }

# 字节 → ipv4 层（20B IPv4 头直喂）
# @param bytes: 该层完整头字节
# @param src: 源 IPv4 地址（伪头部校验和用，可选）
# @param dst: 目标 IPv4 地址（伪头部校验和用，可选）
# @auto: 自动补 total_length（offset 2-3）与 header checksum（offset 10-11）；proto 占位 0 且内层 TCP/UDP/ICMP 时推导
func ipv4_bytes(bytes, src, dst) { layer("ipv4", bytes, src=src, dst=dst) }

# 字节 → ipv6 层（40B IPv6 头直喂）
# @param bytes: 该层完整头字节
# @param src: 源 IPv6 地址（伪头部校验和用，可选）
# @param dst: 目标 IPv6 地址（伪头部校验和用，可选）
# @auto: 自动补 payload_length（offset 4-5）；next_header 占位 59 时按内层推导
func ipv6_bytes(bytes, src, dst) { layer("ipv6", bytes, src=src, dst=dst) }

# 字节 → icmp 层（ICMP 头直喂）
# @param bytes: 该层完整头字节
# @auto: 自动补 checksum（offset 2-3，覆盖头+载荷）
func icmp_bytes(bytes) { layer("icmp", bytes) }

# 字节 → tcp 层（20B TCP 头直喂）
# @param bytes: 该层完整头字节
# @auto: 自动补 checksum（offset 16-17，含外层 IP 伪头部）
func tcp_bytes(bytes) { layer("tcp", bytes) }

# 字节 → udp 层（8B UDP 头直喂）
# @param bytes: 该层完整头字节
# @auto: 自动补 length（offset 4-5）与 checksum（offset 6-7，含外层 IP 伪头部）
func udp_bytes(bytes) { layer("udp", bytes) }

# 字节 → http 层（应用层文本直喂）
# @param bytes: 该层完整字节
# @auto: 原样字节，无自动字段
func http_bytes(bytes) { layer("http", bytes) }

# 字节 → dns 层（DNS 报文直喂）
# @param bytes: 该层完整字节
# @auto: 原样字节，无自动字段
func dns_bytes(bytes) { layer("dns", bytes) }

# 字节构建值函数（引擎字节原语组合）

# 随机 6 字节 MAC（构建期随机）：rand_bytes(6) 直接产出 6 随机字节；
# tpl 的字节列表等宽直通 → 直接 mac(rand_mac()) 用（如随机源 MAC）
func rand_mac() -> bytes { rand_bytes(6) }

# 地址值函数（tpl 模板实现；原引擎 ip4/ip6/mac 值原语下沉至此）

# IPv4 文本 → 4 字节（点分十进制）
# @param s: "1.2.3.4" 或 4 字节列表（等宽直通）；域名需显式 dns()：ip4(dns("host"))
# @auto: 无自动字段
func ip4(s) -> bytes { tpl("%d{4:.}", s) }

# IPv6 文本 → 16 字节（冒号分组，支持 '::' 零填充压缩）
# @param s: "fe80::1" / "::1" / 全 8 组或 16 字节列表（等宽直通）；域名需显式 dns()
# @auto: 无自动字段
func ip6(s) -> bytes { tpl("%x2{8:}", s) }

# MAC 文本 → 6 字节（分隔符容忍：':' / '-' / '.' 混用）
# @param s: "aa:bb:cc:dd:ee:ff" 等；6 字节列表等宽直通（如 rand_mac()）
# @auto: 无自动字段
func mac(s) -> bytes { tpl("%x{6:[-.:]}", s) }

# 域名 → DNS 线格式字节（长度前缀 + 标签 + 尾 0；旧引擎 dns_name 原语下沉，
# tpl `%L` 说明符实现）
# @param s: "example.com"；空标签跳过（尾点/连续点容忍），标签 ≤63B、总长 ≤255B
# @auto: 无自动字段
func dns_name(s) -> bytes { tpl("%L", s) }

# 文本行 → 字节（值 + \r\n）——proto `line` 字段的库值函数对应物（双位置：
# 构造侧编码与字段声明同源，见 GRAMMAR.md §4.2；解析侧空行 = 失败对称）
# @param s: 一行文本（如 "Host: example.com"；line("") 产空行 \r\n 供手动编码）
# @auto: 无自动字段
func line(s="") -> bytes { concat(raw(s), hex("0d0a")) }

# 字节数（字符串按 UTF-8、字节列表原样）→ 整数。旧引擎 len 原语下沉：
# 可组合（count∘raw），无需引擎实现——`qvarint(len(data))` 长度前缀直接可用。
# @param x: 字符串或字节列表
# @auto: 无自动字段
func len(x) -> int { count(raw(x)) }

# cksum（RFC 1071 反码校验和）与 md5/sha1/sha256 摘要是引擎原语（值位置，
# 输入字节列表或字符串），不再需要库层组合——见 `--eng --ls` 原语清单。

# 协议标志位常量（引擎 tcpflags/ip4flags/arpop 原语下沉至此）
# 组合用位运算原语：tcp(flags=bor(syn(), ack()))、ipv4(flags=bor(df(), mf()))；
# 数字直写也可（u8/be16 直通）。doc 注释约定同 net.pkt。

# TCP flags 位常量：u8 1 字节，bit 序 fin=0x01/syn=0x02/rst=0x04/psh=0x08/
# ack=0x10/urg=0x20/ece=0x40/cwr=0x80。注意与 tcp() 的 ack 序列号参数同名——
# 带括号 ack() 是位常量调用，裸 ack 是参数引用，语法上可区分。
# FIN：结束连接
func fin() -> bytes { u8(0x01) }
# SYN：同步序列号（建连置位）
func syn() -> bytes { u8(0x02) }
# RST：重置连接
func rst() -> bytes { u8(0x04) }
# PSH：推送数据（接收方立即交付应用层）
func psh() -> bytes { u8(0x08) }
# ACK：确认号有效
func ack() -> bytes { u8(0x10) }
# URG：紧急指针有效
func urg() -> bytes { u8(0x20) }
# ECE：ECN-Echo（拥塞指示回显）
func ece() -> bytes { u8(0x40) }
# CWR：拥塞窗口缩减
func cwr() -> bytes { u8(0x80) }

# IPv4 flags 位常量（be16 2 字节，与头内 offset 6-7 对齐）
# DF：不分片
func df() -> bytes { be16(0x4000) }
# MF：更多分片
func mf() -> bytes { be16(0x2000) }

# ARP op 常量（be16 2 字节）
# request：ARP 请求
func request() -> bytes { be16(1) }
# reply：ARP 应答
func reply() -> bytes { be16(2) }

export:
- eth_bytes
- arp_bytes
- ipv4_bytes
- ipv6_bytes
- icmp_bytes
- tcp_bytes
- udp_bytes
- http_bytes
- dns_bytes
- rand_mac
- ip4
- ip6
- mac
- dns_name
- line
- len
- fin
- syn
- rst
- psh
- ack
- urg
- ece
- cwr
- df
- mf
- request
- reply
