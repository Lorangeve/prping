# eng_lib/smtp.pkt —— SMTP 协议定义（RFC 5321）
#
# SMTP (Simple Mail Transfer Protocol) 是电子邮件发送协议。
# 本文件定义 SMTP 协议的消息结构，用于学习和调试邮件传输。
#
# SMTP 工作流程：
#   1. 客户端连接 SMTP 服务器（端口 25 或 587）
#   2. 握手：HELO/EHLO 命令
#   3. 身份验证：AUTH 命令（可选）
#   4. 邮件传输：MAIL FROM, RCPT TO, DATA 命令
#   5. 关闭连接：QUIT 命令

# SMTP 命令（RFC 5321 §4.1）
# SMTP 命令结构
# SMTP 命令通过 TCP 连接发送，格式：
#   - 命令名：大写字母
#   - 参数：命令的参数（可选）
#   - 终止符：\r\n
# @param command: 命令名（大写）
#                 常见命令：
#                 - HELO：标识发送方（旧版）
#                 - EHLO：标识发送方（扩展版）
#                 - AUTH：身份验证
#                 - MAIL FROM：指定发件人
#                 - RCPT TO：指定收件人
#                 - DATA：邮件内容
#                 - RSET：重置会话
#                 - VRFY：验证邮箱
#                 - EXPN：展开邮件列表
#                 - NOOP：无操作
#                 - QUIT：退出
#                 - STARTTLS：开始 TLS 加密
# @param arguments: 命令参数（可选）
#                   根据命令类型，参数格式不同：
#                   - HELO/EHLO：发送方域名
#                   - AUTH：认证机制（LOGIN, PLAIN, CRAM-MD5 等）
#                   - MAIL FROM：<发件人地址>
#                   - RCPT TO：<收件人地址>
# @auto: 无自动字段
#[proto]
func smtp_command(command="EHLO", arguments="") -> bytes {
    concat(
        line(command),                      # 命令名：文本行
        line(arguments)                     # 命令参数：文本行
    )
}

# SMTP 响应（RFC 5321 §4.2）
# SMTP 响应结构
# SMTP 响应通过 TCP 连接发送，格式：
#   - 响应码：3 位数字
#   - 分隔符：空格（单行）或连字符（多行）
#   - 响应文本：人类可读的响应信息
#   - 终止符：\r\n
# @param code: 响应码（3 位数字）
#              常见响应码：
#              2xx：成功
#              211：系统状态或系统帮助回复
#              214：帮助信息
#              220：<domain> 服务就绪
#              221：<domain> 服务关闭传输通道
#              235：认证成功
#              250：请求的邮件操作已完成
#              251：用户非本地，将转发到 <forward-path>
#              252：无法验证用户，但会尝试传递
#              354：开始邮件输入，以 <CRLF>.<CRLF> 结束
#              334：认证挑战（BASE64 编码）
#              421：<domain> 服务不可用，关闭传输通道
#              450：邮箱忙，请求的邮件操作未执行
#              451：本地错误，请求的操作中止
#              452：系统存储不足，请求的操作未执行
#              454：临时认证失败
#              500：语法错误，命令无法识别
#              501：参数语法错误
#              502：命令未实现
#              503：命令顺序错误
#              504：命令参数未实现
#              530：需要认证
#              534：认证机制太弱
#              535：认证失败
#              538：加密要求的认证机制不支持
#              550：邮箱不可用
#              551：用户非本地
#              552：超出存储分配
#              553：邮箱名不允许
#              554：传输失败
# @param message: 响应文本（字符串）
#                 人类可读的响应信息
#                 可以包含多行，每行以响应码-开头
# @auto: 无自动字段
#[proto]
func smtp_response(code=220, message="") -> bytes {
    concat(
        be16(code),                         # 响应码：3位数字（这里用2字节存储，实际是3位）
        line(message)                       # 响应文本：文本行
    )
}

# SMTP EHLO 命令
# EHLO 命令结构
# EHLO 是 HELO 的扩展版本，用于标识发送方并协商扩展功能：
#   - 命令：EHLO
#   - 参数：发送方域名或 IP 地址
# @param domain: 发送方域名或 IP 地址（字符串）
#                通常填写客户端的域名或 IP
#                示例："mail.example.com", "192.168.1.1"
# @auto: 无自动字段
#[proto]
func smtp_ehlo(domain="localhost") -> bytes {
    concat(
        line("EHLO"),                      # EHLO 命令
        line(domain)                        # 发送方域名
    )
}

# SMTP MAIL FROM 命令
# MAIL FROM 结构
# 指定邮件的发件人地址：
#   - 命令：MAIL FROM:
#   - 参数：<发件人地址>
# @param address: 发件人地址（字符串）
#                 格式：<user@domain>
#                 示例：<sender@example.com>
# @auto: 无自动字段
#[proto]
func smtp_mail_from(address="") -> bytes {
    concat(
        line("MAIL FROM:"),                # MAIL FROM 命令
        line(address)                       # 发件人地址
    )
}

# SMTP RCPT TO 命令
# RCPT TO 结构
# 指定邮件的收件人地址：
#   - 命令：RCPT TO:
#   - 参数：<收件人地址>
# @param address: 收件人地址（字符串）
#                 格式：<user@domain>
#                 示例：<recipient@example.com>
# @auto: 无自动字段
#[proto]
func smtp_rcpt_to(address="") -> bytes {
    concat(
        line("RCPT TO:"),                  # RCPT TO 命令
        line(address)                       # 收件人地址
    )
}

# SMTP DATA 命令
# DATA 命令结构
# 开始邮件内容的传输：
#   - 命令：DATA
#   - 响应：354 开始输入
#   - 内容：邮件头 + 空行 + 邮件体
#   - 结束：单独一行的点号 "."
# @param content: 邮件内容（字符串）
#                 格式：邮件头 + \r\n\r\n + 邮件体
#                 邮件头包含：
#                 - From：发件人
#                 - To：收件人
#                 - Subject：主题
#                 - Date：日期
#                 - Message-ID：消息 ID
#                 邮件体：纯文本或 HTML
# @auto: 无自动字段
#[proto]
func smtp_data(content="") -> bytes {
    concat(
        line("DATA"),                       # DATA 命令
        #[meta(rest)]
        content,                            # 邮件内容
        line(".")                           # 结束标记
    )
}

# SMTP AUTH 命令
# AUTH 命令结构
# 身份验证命令：
#   - 命令：AUTH
#   - 参数：认证机制
# @param mechanism: 认证机制（字符串）
#                   常见机制：
#                   - LOGIN：用户名/密码认证
#                   - PLAIN：明文认证（BASE64 编码）
#                   - CRAM-MD5：挑战-响应认证
#                   - DIGEST-MD5：摘要认证
# @param credentials: 认证凭据（可选，BASE64 编码）
#                     LOGIN 机制：用户名和密码（BASE64 编码）
#                     PLAIN 机制：\0用户名\0密码（BASE64 编码）
# @auto: 无自动字段
#[proto]
func smtp_auth(mechanism="LOGIN", credentials="") -> bytes {
    concat(
        line("AUTH"),                       # AUTH 命令
        line(mechanism),                    # 认证机制
        line(credentials)                   # 认证凭据
    )
}

export:
- smtp_command
- smtp_response
- smtp_ehlo
- smtp_mail_from
- smtp_rcpt_to
- smtp_data
- smtp_auth
