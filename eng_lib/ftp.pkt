# eng_lib/ftp.pkt —— FTP 协议定义（RFC 959）
#
# FTP (File Transfer Protocol) 是文件传输协议，用于在网络上传输文件。
# 本文件定义 FTP 协议的消息结构，用于学习和调试 FTP 连接。
#
# FTP 使用两个 TCP 连接：
#   1. 控制连接（端口 21）：传输命令和响应
#   2. 数据连接（端口 20 或随机端口）：传输文件数据
#
# FTP 工作模式：
#   - 主动模式（Active）：服务器主动连接客户端的数据端口
#   - 被动模式（Passive）：客户端连接服务器的数据端口

# FTP 命令（RFC 959 §4.1）
# ── FTP 命令结构 ────────────────────────────────────────────────────────────
# FTP 命令通过控制连接发送，格式：
#   - 命令名：4 字母命令（大写）
#   - 参数：命令的参数（可选）
#   - 终止符：\r\n
# ───────────────────────────────────────────────────────────────────────────────
# @param command: 命令名（4 字母，大写）
#                 常见命令：
#                 - USER：指定用户名
#                 - PASS：指定密码
#                 - LIST：列出目录内容
#                 - RETR：下载文件
#                 - STOR：上传文件
#                 - CWD：更改工作目录
#                 - PWD：打印工作目录
#                 - QUIT：退出登录
#                 - PASV：进入被动模式
#                 - PORT：指定数据端口（主动模式）
#                 - TYPE：设置传输类型（A=ASCII, I=二进制）
#                 - SIZE：获取文件大小
#                 - SYST：获取系统类型
#                 - FEAT：获取服务器功能
# @param arguments: 命令参数（可选）
#                   根据命令类型，参数格式不同：
#                   - USER/PASS：用户名/密码
#                   - RETR/STOR：文件路径
#                   - CWD：目录路径
#                   - PORT：h1,h2,h3,h4,p1,p2（IP 和端口）
# @auto: 无自动字段
#[proto]
func ftp_command(command="USER", arguments="") -> bytes {
    concat(
        line(command),                      # 命令名：文本行
        line(arguments)                     # 命令参数：文本行
    )
}

# FTP 响应（RFC 959 §4.2）
# ── FTP 响应结构 ────────────────────────────────────────────────────────────
# FTP 响应通过控制连接发送，格式：
#   - 响应码：3 位数字
#   - 分隔符：空格（单行）或连字符（多行）
#   - 响应文本：人类可读的响应信息
#   - 终止符：\r\n
# ───────────────────────────────────────────────────────────────────────────────
# @param code: 响应码（3 位数字）
#              常见响应码：
#              1xx：肯定初步响应（正在处理）
#              2xx：肯定完成响应（命令成功）
#              3xx：肯定中间响应（需要更多信息）
#              4xx：暂时否定完成响应（暂时错误）
#              5xx：永久否定完成响应（永久错误）
#              详细分类：
#              110：重新启动标记回复
#              120：服务在 nnn 分钟内就绪
#              125：数据连接已打开，开始传输
#              150：文件状态正常，准备打开数据连接
#              200：命令成功
#              211：系统状态或系统帮助回复
#              212：目录状态
#              213：文件状态
#              214：帮助信息
#              215：系统类型
#              220：服务就绪
#              221：服务关闭控制连接
#              225：数据连接已打开
#              226：关闭数据连接
#              227：进入被动模式
#              230：用户登录成功
#              250：文件操作成功
#              257：路径名已创建
#              331：用户名正确，需要密码
#              332：需要登录账户
#              350：需要进一步操作
#              421：服务不可用
#              425：无法打开数据连接
#              426：连接关闭
#              450：文件不可用
#              451：本地错误
#              452：磁盘空间不足
#              500：语法错误
#              501：参数语法错误
#              502：命令未实现
#              503：命令顺序错误
#              504：参数未实现
#              530：未登录
#              532：需要存储账户
#              550：文件不可用
#              551：页面类型未知
#              552：超出存储分配
#              553：文件名不允许
# @param message: 响应文本（字符串）
#                 人类可读的响应信息
#                 可以包含多行，每行以响应码-开头
# @auto: 无自动字段
#[proto]
func ftp_response(code=220, message="") -> bytes {
    concat(
        be16(code),                         # 响应码：3位数字（这里用2字节存储，实际是3位）
        line(message)                       # 响应文本：文本行
    )
}

# FTP PASV 响应（进入被动模式）
# ── PASV 响应结构 ───────────────────────────────────────────────────────────
# 被动模式下，服务器返回数据连接的地址和端口：
#   - 响应码：227
#   - 响应文本：包含 IP 和端口信息
#   - 格式：227 Entering Passive Mode (h1,h2,h3,h4,p1,p2)
#   - h1-h4：服务器 IP 地址的 4 个字节
#   - p1-p2：端口号的 2 个字节（端口 = p1*256 + p2）
# ───────────────────────────────────────────────────────────────────────────────
# @param h1: IP 地址第一个字节（1字节）
# @param h2: IP 地址第二个字节（1字节）
# @param h3: IP 地址第三个字节（1字节）
# @param h4: IP 地址第四个字节（1字节）
# @param p1: 端口号高字节（1字节）
#            端口 = p1*256 + p2
# @param p2: 端口号低字节（1字节）
# @auto: 无自动字段
#[proto]
func ftp_pasv_response(h1=0, h2=0, h3=0, h4=0, p1=0, p2=0) -> bytes {
    concat(
        line("227 Entering Passive Mode"),  # 响应码和消息
        u8(h1),                             # IP 第一字节
        u8(h2),                             # IP 第二字节
        u8(h3),                             # IP 第三字节
        u8(h4),                             # IP 第四字节
        u8(p1),                             # 端口高字节
        u8(p2)                              # 端口低字节
    )
}

# FTP 文件传输模式
# ── FTP 传输模式 ────────────────────────────────────────────────────────────
# FTP 支持两种传输模式：
#   - ASCII 模式（A）：文本文件传输，自动转换换行符
#   - 二进制模式（I）：二进制文件传输，原样传输
# ───────────────────────────────────────────────────────────────────────────────
# @param type: 传输类型（1 字母）
#              A = ASCII 模式（文本文件）
#              I = 二进制模式（图片、程序等）
#              E = EBCDIC 模式（很少使用）
# @auto: 无自动字段
#[proto]
func ftp_type(type="I") -> bytes {
    concat(
        line("TYPE"),                       # TYPE 命令
        line(type)                          # 传输类型
    )
}

# FTP 端口命令（主动模式）
# ── PORT 命令结构 ───────────────────────────────────────────────────────────
# 主动模式下，客户端告诉服务器数据连接的地址和端口：
#   - 格式：PORT h1,h2,h3,h4,p1,p2
#   - h1-h4：客户端 IP 地址的 4 个字节
#   - p1-p2：端口号的 2 个字节（端口 = p1*256 + p2）
# ───────────────────────────────────────────────────────────────────────────────
# @param h1: IP 地址第一个字节（1字节）
# @param h2: IP 地址第二个字节（1字节）
# @param h3: IP 地址第三个字节（1字节）
# @param h4: IP 地址第四个字节（1字节）
# @param p1: 端口号高字节（1字节）
#            端口 = p1*256 + p2
# @param p2: 端口号低字节（1字节）
# @auto: 无自动字段
#[proto]
func ftp_port(h1=0, h2=0, h3=0, h4=0, p1=0, p2=0) -> bytes {
    concat(
        line("PORT"),                       # PORT 命令
        line(concat(h1, ",", h2, ",", h3, ",", h4, ",", p1, ",", p2))  # IP 和端口参数
    )
}

export:
- ftp_command
- ftp_response
- ftp_pasv_response
- ftp_type
- ftp_port
