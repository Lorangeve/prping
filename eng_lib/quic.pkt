# eng_lib/quic.pkt —— QUIC 报文构建（RFC 9000；UDP 封装，无独立校验和）
#
# QUIC 变长整数（2 位长度前缀 1/2/4/8 字节，RFC 9000 §16）在 proto 字段位置用
# vint codec 声明：`#[meta(codec="prefix", prefix_bits=2, widths=[1,2,4,8])]`——
# 方案数据化（与 protobuf 的 base-128 le128 编码不同；protobuf 变长整数用
# `#[meta(codec="le128")]`）。值位置的 `qvarint()`/`varint()` 由 eng_lib/vint.pkt
# 的库 proto 声明提供（proto 双位置，concat 一步拼字节用；引擎无变长整数内置原语）。
# 包号字段**不是** varint——是 pnl+1 字节**大端整数**（RFC 9000 §17.1），由调用方
# 以字节形式给出（默认 pn=u8(0) = 1 字节包号 0）；首字节的 pnl 位 = 包号字节数-1
# （0..3，DSL 无减法运算故作为显式参数，与线格式字段一一对应）。
# Initial 长头的 Length 字段 = 包号 + 载荷长度，用 `+` 自动算
# （len="auto" = 后续字段字节数，prefix codec 编码）。
#
# 注意：Initial 包上线前需 AEAD 加密 + 头部保护（initial secrets 由 DCID 派生，
# 见 RFC 9001 §5.2）——这里构造的是**保护前的裸结构**（长/短头 + 帧字节），
# 用于构造/测试/解剖/手工扩展，不做加密。
#
# doc 注释约定同 net.pkt：摘要 + `@param`/`@auto` 标签行，`--eng --ls` 展示。
#
# ── 学习注释 ──────────────────────────────────────────────────────────────────
# QUIC 是 Google 开发的基于 UDP 的传输协议（RFC 9000），主要特点：
# 1. 基于 UDP：绕过中间设备对 TCP 的优化，减少队头阻塞
# 2. 内置加密：TLS 1.3 集成在握手中，0-RTT 连接建立
# 3. 多路复用：单连接内多个独立流，无队头阻塞
# 4. 连接迁移：基于 Connection ID 而非 IP:Port，网络切换不断连
# 5. 可变长度整数：节省空间的整数编码（1/2/4/8字节）
# ───────────────────────────────────────────────────────────────────────────────

# QUIC 长头 Initial 包（RFC 9000 §17.2.2）：长头 + version + DCID/SCID +
# token（长度 prefix 变长整数）+ Length（prefix 变长整数，len="auto" = pn + payload
# 长度）+ 包号 + 帧——声明式自表示协议（proto）：字段即参数，可构造也可由 dissect
# 反向解析（rule: udp 443 + 首字节 0xc0 长头特征；dcid_len/scid_len/token_len 为
# len="目标" 长度前缀）。
# ── QUIC 长头 Initial 包结构 ─────────────────────────────────────────────────
# Initial 包是 QUIC 握手的第一个包，包含：
#   - 首字节：长头标志(0xc0) + 包号长度位(pnl)
#   - 版本：QUIC 协议版本（0x00000001 = v1）
#   - DCID/SCID：目标/源连接 ID（变长，0-20字节）
#   - Token：令牌（变长，Initial 包可能为空）
#   - Length：载荷长度（变长整数，包含包号+帧数据）
#   - 包号：1-4字节（pnl+1 字节）
#   - 帧数据：CRYPTO 帧（握手数据）、PADDING 帧等
# ───────────────────────────────────────────────────────────────────────────────
# @param pnl: 包号长度位（首字节低2位）
#             = 包号字节数 - 1（0..3）
#             0 = 1字节包号（默认，适合小包号）
#             1 = 2字节包号
#             2 = 3字节包号
#             3 = 4字节包号（最大）
#             与线格式字段一一对应（DSL 无减法运算故作为显式参数）
# @param pn: 包号字段字节（大端 1..4 字节）
#            标识 QUIC 包的序号，用于丢包检测和重传
#            默认 u8(0) = 1字节包号 0
#            字节数必须与 pnl 匹配（pnl+1 字节）
# @param payload: 帧数据（变长）
#                 由 quic_crypto()/pad() 等帧组合
#                 CRYPTO 帧携带 TLS 握手数据
#                 PADDING 帧用于填充（类型 0x00）
# @auto: Length 自动 = pn + payload 字节数（变长整数编码，prefix codec）
#[proto]
#[rule(udp(dport=443))]
#[rule(mask(0xc0))]
func quic_initial(pnl=0, pn=u8(0), payload="") -> bytes {
    concat(
        #[meta(name="first")] u8(bor(0xc0, pnl)),     # 首字节：长头标志(0xc0) + pnl(低2位)
        #[meta(name="version")] be32(0x00000001),       # QUIC版本：1（v1）
        #[meta(len="dcid")] u8(dcid_len),               # DCID长度：1字节（0-20）
        #[meta(bytes="dcid_len")] dcid,                 # 目标连接ID：变长
        #[meta(len="scid")] u8(scid_len),               # SCID长度：1字节（0-20）
        #[meta(bytes="scid_len")] scid,                 # 源连接ID：变长
        #[meta(len="token", codec="prefix", prefix_bits=2, widths=[1,2,4,8])] token_len,  # Token长度：变长整数
        #[meta(bytes="token_len")] token,               # Token数据：变长（Initial包可能为空）
        #[meta(len="auto", codec="prefix", prefix_bits=2, widths=[1,2,4,8])] length,      # 载荷长度：变长整数（自动计算）
        #[meta(bytes="band(first, 3) + 1")] pn,         # 包号：1-4字节（根据pnl确定）
        #[meta(rest="quic_crypto")] payload              # 帧数据：变长（重复解析CRYPTO帧）
    )
}

# QUIC 短头包（RFC 9000 §17.3）：0x40 + spin/reserved/key_phase/pnl + DCID + 包号 + 帧
# ── QUIC 短头包结构 ─────────────────────────────────────────────────────────
# 短头用于 1-RTT 数据传输（握手完成后）：
#   - 首字节：短头标志(0x40) + 包号长度位(pnl) + spin/reserved/key_phase 位
#   - DCID：目标连接 ID（已知，无需 SCID）
#   - 包号：1-4字节（pnl+1 字节）
#   - 帧数据：STREAM、ACK、CRYPTO 等帧
# 短头比长头更紧凑，省略版本和 SCID，适合数据传输阶段。
# ───────────────────────────────────────────────────────────────────────────────
# @param dcid: 目标连接 ID（字节列表，通常 1-20 字节）
#              已建立连接的 DCID，双方已知
#              用于连接迁移：网络切换时 DCID 不变，连接不断
# @param pnl: 包号长度位（首字节低2位）
# @param pn: 包号字段字节（大端 1..4 字节）
#            标识 QUIC 包的序号
#            默认 u8(0) = 1字节包号 0
# @param payload: 帧数据（变长）
#                 包含 STREAM 帧（应用数据）、ACK 帧（确认）等
# @auto: 无自动字段（UDP 层负责伪头部校验和，QUIC 无独立校验和）
func quic_short(dcid, pnl=0, pn=u8(0), payload="") -> bytes {
    concat(
        u8(bor(0x40, pnl)),  # 首字节：短头标志(0x40) + pnl(低2位)
        dcid,                 # 目标连接ID：变长
        pn,                   # 包号：1-4字节
        payload               # 帧数据：变长
    )
}

# CRYPTO 帧（RFC 9000 §19.6）：type 0x06 + offset（prefix 变长整数）+ length
# （prefix 变长整数，len="data" 长度前缀）+ 数据——自表示 proto：frame_type 常量
# 0x06 兼作解析判别位（rest(quic_crypto) 重复解析，PADDING 帧 0x00 不匹配即停止）
# ── QUIC CRYPTO 帧结构 ──────────────────────────────────────────────────────
# CRYPTO 帧用于传输 TLS 握手数据，格式：
#   - 类型：0x06（固定值，用于识别 CRYPTO 帧）
#   - 偏移：数据在加密流中的位置（变长整数）
#   - 长度：数据长度（变长整数）
#   - 数据：TLS 握手消息（ClientHello、ServerHello 等）
# 与 STREAM 帧的区别：CRYPTO 帧用于握手阶段，STREAM 帧用于应用数据。
# ───────────────────────────────────────────────────────────────────────────────
# @param offset: 流内偏移（变长整数，1/2/4/8字节）
#                数据在 TLS 握手中的字节偏移
#                默认 0（握手开始位置）
#                用于重组分片的握手消息
# @param data: 帧数据（变长）
#              TLS 握手消息的字节
#              示例："CHLO"（ClientHello）, "SHLO"（ServerHello）
#              默认 ""（空数据）
# @auto: 无自动字段（CRYPTO 帧无校验和，由 QUIC 包级别保护）
#[proto]
func quic_crypto(offset=0, data="") -> bytes {
    concat(
        #[meta(name="frame_type")] u8(0x06),                                    # 帧类型：0x06（CRYPTO）
        #[meta(codec="prefix", prefix_bits=2, widths=[1,2,4,8])] offset,        # 偏移：变长整数
        #[meta(len="data", codec="prefix", prefix_bits=2, widths=[1,2,4,8])] length,  # 长度：变长整数（自动=数据长度）
        #[meta(bytes="length")] data                                            # 数据：变长
    )
}

export:
- quic_initial
- quic_short
- quic_crypto
