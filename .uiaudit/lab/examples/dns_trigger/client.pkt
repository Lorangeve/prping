# 客户端：发 DNS 查询（id=0x4242）到服务端配方（wait 持续监听触发发包），
# `--wait 2` 校验服务端触发的应答（id 与发包一致 + 应答位 flags=0x8180）。
q = dns(id=0x4242, questions=["example.com"])
full = use(q) |> udp(dport=params("port", 55353)) |> ipv4(dst=params("ip", "127.0.0.1")) |> eth()

export:
- full

sniffer:
  - match dns(id=id, flags=0x8180)
