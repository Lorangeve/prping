# DHCP 流程步骤 3：DHCP Request（客户端确认请求）——dhcp_mock client 配方第 2 步
# 发包（delay: 0.5 后发，见 client.pktl；本文件不单独跑）。
#
# DHCP Request 是客户端对 Offer 的响应：
#   - 客户端从（可能有）多个 Offer 中选定一个
#   - 真实场景中 Request 是**广播**——让所有发过 Offer 的服务器都知道它的选择
#   - 包含请求的 IP 地址（option 50）和选定服务器标识（option 54）
#
# ── mock 说明：destination 复用上一步 extract 的结果 ──
# 真实 Request 走广播；mock 单播发给 global.sip——client.pktl 步骤 1 的
# extract 从 Offer 帧（reply.ipv4.src，即服务端发 Offer用的源地址）提取写入。
# 这是配方的「extract 复用」演示：前一步从回包学到的东西，后一步直接使用
# （回环上它就是 127.0.0.1；真实场景按 RFC 2131 应广播，这里是教学简化）。
# 副作用：若步骤 1 的 wait: 2 超时未等到 Offer，global.sip 未写入，步骤 2 会
# 落到缺省 127.0.0.1（global 第二参）继续发——组间依赖就此放宽，不会硬失败
# （icmp_mock 复用 cid 的组间依赖同理）。
#
# xid 仍固定 0x12345678（真实场景：Request 必须沿用选中 Offer 的 xid；mock
# 没有 dhcp proto 层提取不到，见 listen.pkt 验证结论与 dhcp_discover.pkt 说明）。
request = raw(bytes=[
    0x01,  # op: 1 = BOOTREQUEST
    0x01,  # htype: 1 = 以太网
    0x06,  # hlen: 6 = MAC 地址长度
    0x00,  # hops: 0
    0x12, 0x34, 0x56, 0x78,  # xid: 事务 ID (与 Discover/Offer 相同)
    0x00, 0x00,  # secs: 0
    0x80, 0x00,  # flags: 广播应答
    0x00, 0x00, 0x00, 0x00,  # ciaddr: 0.0.0.0 (客户端仍无 IP)
    0x00, 0x00, 0x00, 0x00,  # yiaddr: 0.0.0.0 (等待确认)
    0x00, 0x00, 0x00, 0x00,  # siaddr: 0.0.0.0
    0x00, 0x00, 0x00, 0x00,  # giaddr: 0.0.0.0
    # chaddr: 客户端 MAC (与 Discover 相同)
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # sname: 服务端主机名 (64 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # file: 启动文件名 (128 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # magic cookie: DHCP 魔术字节 0x63825363
    0x63, 0x82, 0x53, 0x63,
    # DHCP 选项（TLV）
    0x35, 0x01, 0x03,  # Option 53: DHCP Message Type = Request (3)
    0x32, 0x04, 0xC0, 0xA8, 0x01, 0x64,  # Option 50: Requested IP Address = 192.168.1.100
    0x36, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 54: DHCP Server Identifier = 192.168.1.1
    0xff  # End Option
])

# 封装：src 仍按 DHCP 语义写 0.0.0.0（客户端收到 Ack 前不算正式持有地址；
# 校验和说明见 dhcp_discover.pkt 头注）；dst=global.sip 单播（真实场景广播）。
# 包有 udp 传输层，client.pktl 步骤已显式 raw: true（保住伪造的 sport=68）。
use(request) |> udp(sport=68, dport=67) |> ipv4(src="0.0.0.0", dst=global("sip", "127.0.0.1"))

sniffer:
  # wait: 2 校验 server 配方的 Ack（op=2 BOOTREPLY）。三重跨层 AND 与步骤 1
  # 同构：ipv4.proto=17 + udp 67→68 + raw 首字节 mask(0x02)（(op&0x02)==0x02
  # 即 op=2）。Request 自身（op=1、68→67）与内核 ICMP 差错帧被排除；步骤 1
  # 的 Offer 早在此步 wait 开始前就抵达过，不会滞留在本轮抓包里。
  - and(match ipv4(proto=17), match udp(sport=67, dport=68), match raw(mask(0x02)))
