# ICMP Echo Request 步骤（用于多步配方）
# 每个步骤发送一个 ICMP Echo Request 并等待真实应答
#
# 必需参数：
#   - ip: 目标地址（必须通过 -p ip=... 传入）
#
# 可选参数：
#   - seq: 序列号（默认为 1）
#
# 运行方式：
#   # 单独运行（需要 root 权限）
#   sudo prping packet icmp_ping_step --raw --wait 1 -p ip=127.0.0.1
#
#   # 作为配方步骤运行（参数从命令行注入）
#   sudo prping packet icmp_ping_real_4 --raw --wait 1 -p ip=127.0.0.1

# 构造 ICMP Echo Request（Type=8, Code=0）
# id 使用随机数，seq 从参数注入（默认为 1）
req = icmp(type=8, code=0, id=rand16(), seq=params("seq", 1),
           payload="prping icmp ping probe")

# 封装到 IPv4（src=0.0.0.0 由内核自动填充源地址）
# ip 参数必须传入，无默认值
use(req) |> ipv4(src="0.0.0.0", dst=params("ip"), ttl=64)

# 回包校验（--wait）：回包必须是 ICMP Echo Reply 且 id/seq 与发包一致
sniffer:
  - match icmp(id=id, seq=seq)

export:
- req