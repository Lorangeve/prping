# HTTP mock · 服务端配方（server.pktl）：一个 pktl 就是一个 HTTP 服务端。
# 形态同构 examples/icmp_mock/server.pktl：配方显式列出**多组**监听+应答步骤
# （pktl 可包含任意多包），每组 = 一次 listen 命中 → extract 写 global → 触发发包。
# 这里两组对应 client.pktl 的两步请求（GET / POST）；要服务更多次就再写几组。
#
# 每组步骤：
#   步骤 1：listen_*.pkt + wait:（无值 = 持续监听）——包内无 udp/tcp 传输层 →
#           自动选**链路层监听**完整帧（需 root），sniffer 匹配 http(method=...)
#           （GET/POST 帧 dport=80 触发 http 反解快速分派，见 listen_*.pkt 注释）；
#           命中后 extract 匹配帧字段写 global：客户端端口/序列号 + 双向 IP。
#   步骤 2：resp_*.pkt（raw: true 链路层发送）——用 global 构造 200 OK 响应：
#           端口互换（sport=80 → dport=r_sport）、ack = r_seq + 请求字节数
#           （GET 90 / POST 132——TCP 确认号语义的教学点）、seq 固定 0x2000。
#
# 注意：client 步骤 2 带 delay: 0.5，给本配方重开下一轮抓包（AF_PACKET 设备
# 打开）留出时间——回环上 client 亚毫秒就发完，不加 delay 会错过 POST 请求。
#
# 内核副作用（为什么无碍）：mock 不是真 TCP 栈——不握手、不维护连接状态。本机内核
# 看到发往"无监听端口"的帧会回 RST（client→80 无监听、server 收到 200 OK 后内核
# 也会 RST 40000），但 RST 帧载荷为空，反解不出 http 层，listen 的 sniffer
# （http(method=...)）永不误触发；client 的 sniffer 也用 flags="psh,ack" 排除
# RST（flags="rst"）——详见 README「内核 RST 副作用」。
#
# 运行（需 root；AF_PACKET/Npcap 链路层监听）：
#   sudo prping packet examples/http_mock/server.pktl
# 客户端（另一终端）：
#   sudo prping packet examples/http_mock/client.pktl
global:
- r_sport    # 请求方源端口（→ 响应 dport）
- r_seq      # 请求方 TCP 序列号（→ 响应 ack = r_seq + 请求字节数）
- r_src_ip   # 请求方 IP（reply.ipv4.src → 响应 dst）
- r_dst_ip   # 本机 IP（reply.ipv4.dst → 响应 src）

recipe:
# ── 第 1 组：GET → 200 OK（对应 client 步骤 1）──
- packet: listen_get.pkt
  wait:
  extract:
  - name: r_sport
    from: reply.tcp.sport
    as: int
  - name: r_seq
    from: reply.tcp.seq
    as: int
  - name: r_src_ip
    from: reply.ipv4.src
    as: str
  - name: r_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: resp_get.pkt
  raw: true
# ── 第 2 组：POST → 200 OK（对应 client 步骤 2）──
- packet: listen_post.pkt
  wait:
  extract:
  - name: r_sport
    from: reply.tcp.sport
    as: int
  - name: r_seq
    from: reply.tcp.seq
    as: int
  - name: r_src_ip
    from: reply.ipv4.src
    as: str
  - name: r_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: resp_post.pkt
  raw: true
