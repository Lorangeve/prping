# bad_network 步骤 1：TCP SYN（三次握手第一步）
# 模拟网络差的场景：客户端发起连接
# sniffer 匹配 SYN-ACK，--wait 时提取服务端 seq/ack 到 global
p = raw(bytes="")
syn_pkt = use(p) |> tcp(sport=params("sport", 40000), dport=params("port", 80),
                        seq=global("cseq", 0x1000), flags=syn())
                |> ipv4(dst=params("ip", "127.0.0.1"))
                |> eth()

sniffer:
  - match tcp(sport=dport, dport=sport, flags=bor(syn(), ack()))

export:
- syn_pkt
