# eng_lib/net.pkt —— pkglang 标准库：IP + 以太网组合层
# 引擎内置只保留最基础原语（eth/arp/ipv4/ipv6/icmp/tcp/udp/http/dns/raw/hex），
# 组合函数统一放库（eng_lib，发布时复制为 lib/ 目录）。
# 用法：import net { net4, net6 }   或   import net（引入全部导出）
#
# 参数约定：
# - 无默认值的参数 = 未设：在层参数位置省略 → 自动值（如 proto/tos/flags/ethertype 自动推导）；
# - 有默认值的参数在调用未传时生效："random" = 随机单播值。
#
# doc 注释约定：紧贴函数上方的连续 `#` 行为该函数的说明——非标签行为摘要，
# `@param 名: 说明` 逐参数说明，`@auto: 说明` 描述序列化自动行为；`--eng --ls` 展示。

# 一次生成 [ipv4, eth] 两层；默认 src/源 MAC 全零、TTL 64、dst_mac 广播
# @param dst: 目标 IPv4 地址（必填；可域名，按 v4 解析）
# @param src: 源 IPv4 地址；默认 0.0.0.0（raw 发送时自动填本地地址）
# @param ttl: IP 生存时间
# @param id: IP 标识（分片用）
# @param proto: 内层协议号；省略按内层推导（icmp→1/tcp→6/udp→17）
# @param tos: 服务类型（Type of Service）
# @param flags: IP 标志（"df"/"mf"，默认无）
# @param src_mac: 源 MAC；默认全零（raw 发送时网关不认，建议显式指定或随机）
# @param dst_mac: 目标 MAC；默认广播
# @param ethertype: 以太网类型；默认 0x0800（IPv4）
# @auto: 自动补 IPv4 total_length/header checksum、eth ethertype；proto 按内层推导
func net4(dst, src="0.0.0.0", ttl=64, id=0, proto, tos, flags,
          src_mac="00:00:00:00:00:00", dst_mac="ff:ff:ff:ff:ff:ff", ethertype=0x0800) {
    ipv4(src=src, dst=dst, ttl=ttl, proto=proto, tos=tos, id=id, flags=flags)
        |> eth(src_mac=src_mac, dst_mac=dst_mac, ethertype=ethertype)
}

# 一次生成 [ipv6, eth] 两层；默认 src/源 MAC 全零、hop_limit 64、dst_mac 广播
# @param dst: 目标 IPv6 地址（必填；可域名，按 v6 解析）
# @param src: 源 IPv6 地址；默认 ::（raw 发送时自动填本地地址）
# @param hop_limit: 跳数限制
# @param next_header: 内层协议头类型；省略按内层推导（icmp→58/tcp→6/udp→17）
# @param src_mac: 源 MAC；默认全零（raw 发送时网关不认，建议显式指定或随机）
# @param dst_mac: 目标 MAC；默认广播
# @param ethertype: 以太网类型；默认 0x0800（IPv4 占位，内层 IPv6 时自动推导 0x86dd）
# @auto: 自动补 IPv6 payload_length、eth ethertype；next_header 按内层推导
func net6(dst, src="::", hop_limit=64, next_header,
          src_mac="00:00:00:00:00:00", dst_mac="ff:ff:ff:ff:ff:ff", ethertype=0x0800) {
    ipv6(src=src, dst=dst, hop_limit=hop_limit, next_header=next_header)
        |> eth(src_mac=src_mac, dst_mac=dst_mac, ethertype=ethertype)
}

export:
- net4
- net6
