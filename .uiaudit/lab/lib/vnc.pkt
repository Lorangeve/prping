# eng_lib/vnc.pkt —— VNC 协议定义（RFC 6143）
#
# VNC (Virtual Network Computing) 是远程桌面协议，
# 用于在本地计算机上显示和控制远程计算机的桌面。
#
# VNC 特点：
#   - 跨平台：支持多种操作系统
#   - 开放协议：RFC 6143 标准化
#   - 简单架构：客户端-服务器模式
#   - 可扩展：支持多种编码方式和安全机制
#
# VNC 工作流程：
#   1. 握手阶段：协议版本协商
#   2. 安全阶段：身份验证
#   3. 初始化阶段：桌面参数交换
#   4. 交互阶段：鼠标、键盘事件和屏幕更新

# VNC 协议版本（RFC 6143 §7.1.1）
# VNC 版本结构
# VNC 握手开始时，双方交换协议版本：
#   - 格式："RFB xxx.yyy\n"
#   - xxx：主版本号（3 位数字）
#   - yyy：次版本号（3 位数字）
# @param major_version: 主版本号（字符串，3 位数字）
#                       常见值："003"（VNC 3.3）、"004"（VNC 4.0）
# @param minor_version: 次版本号（字符串，3 位数字）
#                       常见值："003"（3.3）、"008"（3.8）、"007"（3.7）
# @auto: 无自动字段（版本字符串固定格式）
#[proto]
func vnc_version(major_version="003", minor_version="008") -> bytes {
    concat(
        line("RFB " + major_version + "." + minor_version)  # 版本字符串
    )
}

# VNC 安全类型（RFC 6143 §7.1.2）
# VNC 安全类型结构
# 服务器支持的安全类型列表：
#   - 安全类型数量：后续安全类型字节数量
#   - 安全类型列表：每个类型 1 字节
# @param security_types: 安全类型数量（1字节）
#                        服务器支持的安全类型数量
# @param security_type_list: 安全类型列表（变长，每项1字节）
#                            安全类型：
#                            0 = 无效
#                            1 = 无（无认证）
#                            2 = VNC 认证（密码）
#                            16 = Tight
#                            17 = Ultra
#                            18 = TLS
#                            19 = VeNCrypt
#                            20 = GTK-VNC SASL
#                            21 = MD5 hash authentication
#                            22 = Colin Dean xvp
# @auto: 无自动字段
#[proto]
func vnc_security_types(security_types=1, security_type_list="") -> bytes {
    concat(
        u8(security_types),                 # 安全类型数量：1字节
        #[meta(rest="security_type_list")] security_type_list  # 安全类型列表：变长
    )
}

# VNC 安全结果（RFC 6143 §7.1.3）
# VNC 安全结果结构
# 安全验证后的结果：
#   - 状态：0 = 成功，1 = 失败
# @param status: 安全状态（4字节，大端序）
#                0 = 成功（OK）
#                1 = 失败（Failed）
# @auto: 无自动字段
#[proto]
func vnc_security_result(status=0) -> bytes {
    concat(
        be32(status)                        # 安全状态：4字节
    )
}

# VNC 客户端初始化（RFC 6143 §7.3.1）
# VNC 客户端初始化结构
# 客户端发送的初始化消息：
#   - 共享标志：是否允许其他客户端同时连接
# @param shared_flag: 共享标志（1字节）
#                     0 = 独占连接（其他客户端断开）
#                     1 = 共享连接（允许其他客户端）
# @auto: 无自动字段
#[proto]
func vnc_client_init(shared_flag=0) -> bytes {
    concat(
        u8(shared_flag)                     # 共享标志：1字节
    )
}

# VNC 服务器初始化（RFC 6143 §7.3.2）
# VNC 服务器初始化结构
# 服务器发送的初始化消息，包含桌面信息：
#   - 帧缓冲宽度：屏幕宽度（像素）
#   - 帧缓冲高度：屏幕高度（像素）
#   - 像素格式：像素编码格式
#   - 名称长度：桌面名称的长度
#   - 名称：桌面名称字符串
# @param framebuffer_width: 帧缓冲宽度（2字节，大端序）
#                           屏幕宽度（像素）
# @param framebuffer_height: 帧缓冲高度（2字节，大端序）
#                            屏幕高度（像素）
# @param pixel_format: 像素格式（16字节）
#                      包含：
#                      - 位深度（bits-per-pixel）
#                      - 颜色深度（depth）
#                      - 大端序标志（big-endian-flag）
#                      - 真彩色标志（true-colour-flag）
#                      - 红色最大值、绿色最大值、蓝色最大值
#                      - 红色位移、绿色位移、蓝色位移
# @param name_length: 名称长度（4字节，大端序）
#                     桌面名称的长度（字节）
# @param name: 桌面名称（变长）
#              桌面的名称字符串
# @auto: 无自动字段
#[proto]
func vnc_server_init(framebuffer_width=1024, framebuffer_height=768, pixel_format="", name_length=0, name="") -> bytes {
    concat(
        be16(framebuffer_width),            # 帧缓冲宽度：2字节
        be16(framebuffer_height),           # 帧缓冲高度：2字节
        #[meta(bytes="16")] pixel_format,   # 像素格式：16字节
        be32(name_length),                  # 名称长度：4字节
        #[meta(rest="name")] name           # 桌面名称：变长
    )
}

# VNC 像素格式（RFC 6143 §7.4.1）
# VNC 像素格式结构
# 像素格式描述像素的编码方式：
#   - 位深度：每像素的位数（8、16、32）
#   - 颜色深度：实际使用的颜色位数
#   - 大端序标志：像素数据的字节序
#   - 真彩色标志：是否使用真彩色
#   - 颜色最大值：红、绿、蓝通道的最大值
#   - 颜色位移：红、绿、蓝通道的位移
# @param bits_per_pixel: 位深度（1字节）
#                        每像素的位数：8、16、32
# @param depth: 颜色深度（1字节）
#               实际使用的颜色位数：8、16、24
# @param big_endian_flag: 大端序标志（1字节）
#                         0 = 小端序
#                         1 = 大端序
# @param true_colour_flag: 真彩色标志（1字节）
#                          0 = 使用调色板
#                          1 = 使用真彩色
# @param red_max: 红色最大值（2字节，大端序）
#                 红色通道的最大值
# @param green_max: 绿色最大值（2字节，大端序）
#                   绿色通道的最大值
# @param blue_max: 蓝色最大值（2字节，大端序）
#                  蓝色通道的最大值
# @param red_shift: 红色位移（1字节）
#                   红色通道的位移位数
# @param green_shift: 绿色位移（1字节）
#                     绿色通道的位移位数
# @param blue_shift: 蓝色位移（1字节）
#                    蓝色通道的位移位数
# @auto: 无自动字段
#[proto]
func vnc_pixel_format(bits_per_pixel=32, depth=24, big_endian_flag=0, true_colour_flag=1, red_max=255, green_max=255, blue_max=255, red_shift=16, green_shift=8, blue_shift=0) -> bytes {
    concat(
        u8(bits_per_pixel),                 # 位深度：1字节
        u8(depth),                          # 颜色深度：1字节
        u8(big_endian_flag),                # 大端序标志：1字节
        u8(true_colour_flag),               # 真彩色标志：1字节
        be16(red_max),                      # 红色最大值：2字节
        be16(green_max),                    # 绿色最大值：2字节
        be16(blue_max),                     # 蓝色最大值：2字节
        u8(red_shift),                      # 红色位移：1字节
        u8(green_shift),                    # 绿色位移：1字节
        u8(blue_shift),                     # 蓝色位移：1字节
        u8(0), u8(0), u8(0)                 # 填充：3字节（保留）
    )
}

# VNC 键盘事件（RFC 6143 §7.5.4）
# VNC 键盘事件结构
# 键盘事件，按下或释放键：
#   - 消息类型：4（键盘事件）
#   - 按下标志：1 = 按下，0 = 释放
#   - 键符号：X Window System 键符号
# @param message_type: 消息类型（1字节）
#                      固定为 4
# @param down_flag: 按下标志（1字节）
#                   1 = 按下（key press）
#                   0 = 释放（key release）
# @param key: 键符号（4字节，大端序）
#             X Window System 键符号
#             常见值：
#             0x0000FF08 = BackSpace
#             0x0000FF09 = Tab
#             0x0000FF0D = Return
#             0x0000FF1B = Escape
#             0x0000FF51 = Left
#             0x0000FF52 = Up
#             0x0000FF53 = Right
#             0x0000FF54 = Down
# @auto: 无自动字段
#[proto]
func vnc_key_event(message_type=4, down_flag=1, key=0) -> bytes {
    concat(
        u8(message_type),                   # 消息类型：1字节
        u8(down_flag),                      # 按下标志：1字节
        be16(0),                            # 填充：2字节
        be32(key)                           # 键符号：4字节
    )
}

# VNC 鼠标事件（RFC 6143 §7.5.5）
# VNC 鼠标事件结构
# 鼠标事件，鼠标移动或按钮点击：
#   - 消息类型：5（鼠标事件）
#   - 按钮掩码：鼠标按钮状态
#   - x 位置：鼠标 x 坐标
#   - y 位置：鼠标 y 坐标
# @param message_type: 消息类型（1字节）
#                      固定为 5
# @param button_mask: 按钮掩码（1字节）
#                     位 0 = 左键
#                     位 1 = 中键
#                     位 2 = 右键
#                     位 3 = 滚轮向上
#                     位 4 = 滚轮向下
# @param x_position: x 位置（2字节，大端序）
#                    鼠标 x 坐标（像素）
# @param y_position: y 位置（2字节，大端序）
#                    鼠标 y 坐标（像素）
# @auto: 无自动字段
#[proto]
func vnc_pointer_event(message_type=5, button_mask=0, x_position=0, y_position=0) -> bytes {
    concat(
        u8(message_type),                   # 消息类型：1字节
        u8(button_mask),                    # 按钮掩码：1字节
        be16(x_position),                   # x位置：2字节
        be16(y_position)                    # y位置：2字节
    )
}

# VNC 帧缓冲更新请求（RFC 6143 §7.5.3）
# VNC 帧缓冲更新请求结构
# 客户端请求屏幕更新：
#   - 消息类型：3（帧缓冲更新请求）
#   - 增量标志：是否只请求变化的区域
#   - x 位置：请求区域的 x 坐标
#   - y 位置：请求区域的 y 坐标
#   - 宽度：请求区域的宽度
#   - 高度：请求区域的高度
# @param message_type: 消息类型（1字节）
#                      固定为 3
# @param incremental: 增量标志（1字节）
#                     0 = 完整更新（发送整个屏幕）
#                     1 = 增量更新（只发送变化的区域）
# @param x_position: x 位置（2字节，大端序）
#                    请求区域的 x 坐标
# @param y_position: y 位置（2字节，大端序）
#                    请求区域的 y 坐标
# @param width: 宽度（2字节，大端序）
#               请求区域的宽度
# @param height: 高度（2字节，大端序）
#                请求区域的高度
# @auto: 无自动字段
#[proto]
func vnc_framebuffer_update_request(message_type=3, incremental=0, x_position=0, y_position=0, width=1024, height=768) -> bytes {
    concat(
        u8(message_type),                   # 消息类型：1字节
        u8(incremental),                    # 增量标志：1字节
        be16(x_position),                   # x位置：2字节
        be16(y_position),                   # y位置：2字节
        be16(width),                        # 宽度：2字节
        be16(height)                        # 高度：2字节
    )
}

# VNC 帧缓冲更新（RFC 6143 §7.6.1）
# VNC 帧缓冲更新结构
# 服务器发送的屏幕更新：
#   - 消息类型：0（帧缓冲更新）
#   - 填充：1 字节
#   - 矩形数量：更新的矩形区域数量
#   - 矩形列表：每个矩形包含位置、大小、编码类型和数据
# @param message_type: 消息类型（1字节）
#                      固定为 0
# @param padding: 填充（1字节）
#                 必须为 0
# @param number_of_rectangles: 矩形数量（2字节，大端序）
#                              更新的矩形区域数量
# @param rectangles: 矩形列表（变长）
#                    每个矩形包含：
#                    - x 位置（2字节）
#                    - y 位置（2字节）
#                    - 宽度（2字节）
#                    - 高度（2字节）
#                    - 编码类型（4字节）
#                    - 像素数据（变长）
# @auto: 无自动字段
#[proto]
func vnc_framebuffer_update(message_type=0, number_of_rectangles=0, rectangles="") -> bytes {
    concat(
        u8(message_type),                   # 消息类型：1字节
        u8(0),                              # 填充：1字节
        be16(number_of_rectangles),         # 矩形数量：2字节
        #[meta(rest="rectangles")] rectangles  # 矩形列表：变长
    )
}

export:
- vnc_version
- vnc_security_types
- vnc_security_result
- vnc_client_init
- vnc_server_init
- vnc_pixel_format
- vnc_key_event
- vnc_pointer_event
- vnc_framebuffer_update_request
- vnc_framebuffer_update
