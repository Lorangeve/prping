# 底层数据组装 demo：raw/hex 字节载荷 → IP/Eth 层包（pkglang 标准库 eng_lib/data.pkt）
# 运行：prping --eng examples/data_demo.pkt
#      prping --pkg examples/data_demo.pkt   （目标从包内推导）
#
# 库导出隐式可见：data/net 模块的 export 无需 import 直接可用
# （显式 import data { ... } 仍支持，用于消歧/子集）

# 十六进制载荷直接做成以太网帧（[raw, eth]）
frame = eth_frame(payload=hex("deadbeef"), ethertype=0x0800)

# 字符串载荷做成 IPv4 包（[raw, ipv4]）
ip = ip4_packet(payload="probe", dst="8.8.8.8", proto=17)

# 字节列表载荷做成 IPv4 完整包（[raw, ipv4, eth]）
net = net4_packet(payload=[0x48, 0x69], dst="1.1.1.1")

# 字节载荷做成 IPv6 完整包（[raw, ipv6, eth]）
v6 = net6_packet(payload="v6", dst="2001:4860:4860::8888")

export:
- frame
- ip
- net
- v6
