# TCP+HTTP mock · 服务端配方（server.pktl）：一个 pktl 就是一个「TCP 握手 + HTTP
# 静态页」服务端。配方显式列出**两组**监听+应答步骤（pktl 可含任意多包），
# 每组对应 client.pktl 的一步：
#
#   第 1 组（对应 client 步骤 1 发 SYN）：
#     listen_syn.pkt —— wait: -1（= 持续监听）链路层匹配纯 SYN（flags="syn"），
#                       命中后 extract 请求方端口/ISN/双向 IP 写 global；
#     synack.pkt     —— 触发发包：SYN-ACK（ack=请求 seq+1，固定服务端 ISN 0x2000）。
#   第 2 组（对应 client 步骤 3 发 GET；client 步骤 2 的纯 ACK 无应答、也无监听——
#            第三次握手本来就无应答，两个配方对此的理解刻意一致）：
#     listen_get.pkt —— 链路层匹配 http(method="GET")（dport=80 端口分派），
#                       extract 客户端端口/GET 的 seq/ack/双向 IP 写 global；
#     http_resp.pkt  —— 触发发包：200 OK（seq=GET 的 ack，ack=GET 的 seq+38）。
#
# 注意：client 步骤 2/3 带 delay: 0.5——本配方每组命中后都要重新打开下一轮抓包
# （pcap 设备枚举 + BPF），回环上 client 全程亚毫秒，不加 delay 会错过第二个包
# （经验来自 examples/icmp_mock/README「为什么 seq 是 1001/1002」一节）。
#
# 运行（需 root；Linux AF_PACKET 链路层抓包 + raw socket 发包）：
#   sudo prping packet examples/tcp_http_mock/server.pktl
# 客户端（另一终端，见 client.pktl）：
#   sudo prping packet examples/tcp_http_mock/client.pktl 127.0.0.1
global:
- r_sport
- r_seq
- r_src_ip
- r_dst_ip
- r2_sport
- r2_seq
- r2_ack
- r2_src_ip
- r2_dst_ip

recipe:
# ── 第 1 组：监听纯 SYN → extract → 触发发包 SYN-ACK（client 步骤 1）──
- packet: listen_syn.pkt
  wait: -1
  extract:
  - name: r_sport
    from: reply.tcp.sport
    as: int
  - name: r_seq
    from: reply.tcp.seq
    as: int
  - name: r_src_ip
    from: reply.ipv4.src
    as: str
  - name: r_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: synack.pkt
  raw: true
# ── 第 2 组：监听 http GET → extract → 触发发包 200 OK（client 步骤 3）──
- packet: listen_get.pkt
  wait: -1
  extract:
  - name: r2_sport
    from: reply.tcp.sport
    as: int
  - name: r2_seq
    from: reply.tcp.seq
    as: int
  - name: r2_ack
    from: reply.tcp.ack
    as: int
  - name: r2_src_ip
    from: reply.ipv4.src
    as: str
  - name: r2_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: http_resp.pkt
  raw: true
