# TCP+HTTP mock · 客户端配方（client.pktl）：三步模拟完整流程——SYN → ACK → GET，
# 每步 wait 校验应答并 extract 复用（配方可包含任意多包）。
#
# 步骤 1  syn.pkt      发 SYN（seq=0x1000）→ wait: 2 校验 SYN-ACK（sport=80、
#                      flags=SYN|ACK 字节 0x12、ack=0x1001=本方 seq+1）→ extract
#                      reply.tcp.seq 写 global.sseq（服务端 ISN 动态提取）。
# 步骤 2  tcp_ack.pkt  delay: 0.5 后发第三次握手 ACK（seq=0x1001, ack=sseq+1），
#                      wait: 0——第三次握手无应答。
# 步骤 3  http_get.pkt delay: 0.5 后发 GET（PSH|ACK，seq=0x1001, ack=sseq+1）→
#                      wait: 2 校验 200 OK（tcp 字段 + http version=整行状态行）。
#
# 为什么步骤 2/3 加 delay: 0.5：server.pktl 每命中一组都要重新打开下一轮抓包
# （pcap 设备枚举 + BPF），回环上 client 全程亚毫秒，不 delay 会在 server 下一轮
# 监听就绪前发包而错过。步骤 2 的纯 ACK 虽无应答，但 server 第 2 组监听要等第 1 组
# 收尾后才就绪，统一 delay 保证 GET 一定落在就绪的监听窗口内（经验来自
# examples/icmp_mock/README「为什么 seq 是 1001/1002」：不加 delay 表现为"少命中"）。
#
# 固定值声明：客户端 ISN=0x1000、sport=40000、目标端口 80、服务端 ISN=0x2000
# （server 侧）——固定值便于教学对照（README 时序表逐项对账）；真实场景应随机化/
# 动态提取（服务端 ISN 的动态提取已在步骤 1 演示）。
#
# 运行（需 root；与 server.pktl 同机两个终端）：
#   sudo prping packet examples/tcp_http_mock/client.pktl 127.0.0.1
#   （-p ip= / -p sip= / -p port= 可注入目标地址/源地址/目标端口；回环缺省即闭环；
#     对比 Scapy 的 sr1(IP(dst)/TCP(dport=80)/"GET ...") 自动握手——这里每一段都
#     手动拆解，教学价值正在于看得见每一步的 seq/ack）
global:
- name: cseq      # 客户端初始序号（步骤 1 SYN 的 seq；sniffer 的 ack=0x1001 与它 +1 对应）
  init: 0x1000
- name: sseq      # 服务端初始序号（步骤 1 从 SYN-ACK extract 覆盖；步骤 2/3 用它 +1 当确认号）
  init: 0

recipe:
- packet: syn.pkt
  raw: true
  wait: 2
  extract:
  - name: sseq
    from: reply.tcp.seq
    as: int
- packet: tcp_ack.pkt
  raw: true
  wait: 0
  delay: 0.5
- packet: http_get.pkt
  raw: true
  wait: 2
  delay: 0.5
