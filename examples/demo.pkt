# 演示：DNS over UDP / HTTP over TCP / VNC 原始载荷 / ARP 请求
# 运行：prping --eng examples/demo.pkt        （精美输出）
#      prping --pkg examples/demo.pkt HOST:PORT（发送到本地监听服务）

export:
- dns_query
- http_get
- vnc_hello
- arp_probe

dns_query = dns(id=0x1234, questions=["example.com"])
http_get = http(method="GET", path="/")
vnc_hello = raw(bytes="RFB 003.008\n")
arp_probe = arp(op="request", spa="192.168.1.1", tpa="192.168.1.2")

# 默认导出：DNS over UDP（含完整协议栈，--pkg 时发 DNS 载荷）
use(dns_query) |> udp(dport=53)
              |> ipv4(src="1.1.1.1", dst="8.8.8.8")
              |> eth(src_mac="00:11:22:33:44:55", dst_mac="66:77:88:99:aa:bb")
