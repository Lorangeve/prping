# wait 超时处理（on_timeout）：步骤 wait: 2 未收到匹配应答 → 打印超时信息并发送
# fallback.pkt（发其它包），配方继续。
#
# 运行（终端 1，用一个端口收 fallback）：nc -u -l 127.0.0.1 59999
#   （macOS 无 nc -u -l？用 prping packet --wait fallback 监听端口的服务端，
#    或任意 UDP 回显服务端）
# 配方：prping packet examples/wait_timeout/recipe.pktl
recipe:
- packet: probe.pkt
  wait: 2
  on_timeout: fallback.pkt
  params: qport=58888,fport=59999
