# TCP 三次握手客户端配方（client.pktl）：client.pkt 先后导出 SYN + 最终 ACK，
# wait: 2 校验服务端配方的 SYN-ACK，并 extract 服务端 ISN 写 global.sseq。
#
# extract sseq 是真实握手的标志性动作——客户端从 SYN-ACK 里学到服务端序号
# （本示例到此为止；用提取值动态构造后续包的完整变体见 ../tcp_http_mock/，
# 那里 ACK 与 GET 的 ack 都来自 extract，而非固定值）。
#
# 运行（需 root；与 server.pktl 同机两个终端）：
#   sudo prping packet examples/tcp_handshake_listen/client.pktl 127.0.0.1
global:
- sseq

recipe:
- packet: client.pkt
  raw: true
  wait: 2
  extract:
  - name: sseq
    from: reply.tcp.seq
    as: int
