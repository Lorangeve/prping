# TCP 三次握手·服务端（packet --wait --raw，裸 --wait = 持续监听）
#
# 运行（需 root；Linux AF_PACKET / macOS·Win libpcap）：
#   sudo prping packet --wait --raw server.pkt
# 客户端（另一终端，见 client.pkt 注释）。
#
# 监听规则：只响应**纯 SYN**（flags="syn" 精确匹配；SYN-ACK 显示 "syn,ack" 不命中，
# 避免把自己刚注入的 SYN-ACK 当成新请求——另有自注入字节去重兜底）。
sniffer:
  - match tcp(flags="syn")

# 应答模板（默认导出）：SYN-ACK——seq=服务端 ISN(0x2000)，ack=请求 seq+1，
# 端口/IP 互换，flags=syn+ack；校验和由序列化器自动重算。
# 裸 IP 外层（无 eth 层）：应答经内核 IP 栈路由注入（Linux IPPROTO_RAW+IP_HDRINCL /
# macOS 按协议 raw socket），回环与局域网均无需 MAC 解析——macOS lo0 也能工作。
payload = raw(bytes="")
use(payload) |> tcp(sport=80, dport=reply("tcp", "sport"), seq=0x2000, ack=reply("tcp", "seq") + 1, flags=bor(syn(), ack()), window=65535) |> ipv4(dst=reply("ipv4", "src"), src=reply("ipv4", "dst"))
