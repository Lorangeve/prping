# TCP 三次握手 · 服务端配方（server.pktl）：监听触发 + extract 取值 + 触发发包。
#
# 步骤 1：`wait: -1`（= 持续监听）——listen.pkt 无传输层 → 自动链路层监听
#         完整帧，匹配纯 SYN（flags="syn"），命中后 extract 匹配帧字段写 global：
#         客户端端口/序列号 + 双向 IP。
# 步骤 2：触发发包——synack.pkt 构造 SYN-ACK（ack=请求 seq+1）发回请求方
#         （raw: true：有 tcp 传输层，必须显式 raw 才不会走 TCP 载荷建连）。
#
# 运行（需 root；Linux AF_PACKET / macOS·Win libpcap）：
#   sudo prping packet examples/tcp_handshake_listen/server.pktl
# 客户端（另一终端，见 client.pkt 注释）：
#   sudo prping packet --raw --wait 2 examples/tcp_handshake_listen/client.pkt 127.0.0.1
global:
- r_sport
- r_seq
- r_src_ip
- r_dst_ip

recipe:
- packet: listen.pkt
  wait: -1
  extract:
  - name: r_sport
    from: reply.tcp.sport
    as: int
  - name: r_seq
    from: reply.tcp.seq
    as: int
  - name: r_src_ip
    from: reply.ipv4.src
    as: str
  - name: r_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: synack.pkt
  raw: true
