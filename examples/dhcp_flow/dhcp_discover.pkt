# DHCP 流程步骤 1：DHCP Discover（客户端广播发现）
# 学习 DHCP 协议的地址分配流程
#
# DHCP (Dynamic Host Configuration Protocol) 是网络配置协议：
#   - 自动分配 IP 地址、子网掩码、网关、DNS 服务器
#   - 基于 UDP 协议（客户端端口 68，服务端端口 67）
#
# DHCP 四步流程（DORA）：
#   1. Discover - 客户端广播："谁能给我 IP 地址？"
#   2. Offer    - 服务端回复："我可以给你 IP X"
#   3. Request  - 客户端确认："我要 IP X"
#   4. Ack      - 服务端确认："IP X 已分配给你"
#
# DHCP 报文结构：
#   - op: 操作码（1=请求, 2=应答）
#   - htype: 硬件类型（1=以太网）
#   - hlen: 硬件地址长度（6=MAC）
#   - xid: 事务 ID（匹配请求/应答）
#   - flags: 标志（最高位 1=广播应答）
#   - ciaddr: 客户端 IP（请求时为 0.0.0.0）
#   - yiaddr: 你的 IP（服务端分配的 IP）
#   - siaddr: 服务端 IP
#   - chaddr: 客户端 MAC 地址
#
# 运行：sudo prping packet dhcp_discover --raw --wait 2
# 注意：DHCP 需要 raw socket 发送（广播），需 root 权限

# 构造 DHCP Discover 报文
# op=1 (请求), htype=1 (以太网), hlen=6 (MAC), hops=0
# xid=0x12345678 (事务 ID)
# flags=0x8000 (广播应答)
# ciaddr=0.0.0.0 (客户端无 IP)
# yiaddr=0.0.0.0 (待分配)
# siaddr=0.0.0.0 (无指定服务端)
# chaddr=客户端 MAC
discover = raw(bytes=[
    0x01,  # op: 1 = BOOTREQUEST
    0x01,  # htype: 1 = 以太网
    0x06,  # hlen: 6 = MAC 地址长度
    0x00,  # hops: 0
    0x12, 0x34, 0x56, 0x78,  # xid: 事务 ID
    0x00, 0x00,  # secs: 0
    0x80, 0x00,  # flags: 广播应答
    0x00, 0x00, 0x00, 0x00,  # ciaddr: 0.0.0.0 (客户端无 IP)
    0x00, 0x00, 0x00, 0x00,  # yiaddr: 0.0.0.0 (待分配)
    0x00, 0x00, 0x00, 0x00,  # siaddr: 0.0.0.0
    0x00, 0x00, 0x00, 0x00,  # giaddr: 0.0.0.0
    # chaddr: 客户端 MAC (16 字节，前 6 字节有效)
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55,  # MAC 地址
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # sname: 服务端主机名 (64 字节，全 0)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # file: 启动文件名 (128 字节，全 0)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # magic cookie: DHCP 魔术字节
    0x63, 0x82, 0x53, 0x63,
    # DHCP 选项
    0x35, 0x01, 0x01,  # Option 53: DHCP Message Type = Discover (1)
    0x3d, 0x07, 0x01, 0x00, 0x11, 0x22, 0x33, 0x44, 0x55,  # Option 61: Client Identifier
    0x37, 0x04, 0x01, 0x03, 0x06, 0x0f,  # Option 55: Parameter Request List (Subnet, Router, DNS, Domain)
    0xff  # End Option
])

# 封装到 UDP（客户端端口 68，服务端端口 67）
use(discover) |> udp(sport=68, dport=67)
              |> ipv4(src="0.0.0.0", dst="255.255.255.255")

export:
- discover
