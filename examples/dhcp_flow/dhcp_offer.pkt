# DHCP 流程步骤 2：DHCP Offer（服务端回复提供 IP）
# 学习 DHCP 协议的地址分配流程
#
# DHCP Offer 是服务端对 Discover 的响应：
#   - 包含分配给客户端的 IP 地址 (yiaddr)
#   - 包含租约时间、子网掩码、网关、DNS 等配置
#   - 通常以广播方式发送（客户端此时还没有 IP）
#
# 注意：真实场景中，Offer 由 DHCP 服务器自动生成，
# 这里构造的是模拟 Offer，用于理解协议结构

# 构造 DHCP Offer 报文
# op=2 (应答), htype=1 (以太网), hlen=6 (MAC), hops=0
# xid=0x12345678 (与 Discover 相同的事务 ID)
# flags=0x8000 (广播应答)
# ciaddr=0.0.0.0
# yiaddr=192.168.1.100 (分配给客户端的 IP)
# siaddr=192.168.1.1 (DHCP 服务器 IP)
# chaddr=客户端 MAC
offer = raw(bytes=[
    0x02,  # op: 2 = BOOTREPLY
    0x01,  # htype: 1 = 以太网
    0x06,  # hlen: 6 = MAC 地址长度
    0x00,  # hops: 0
    0x12, 0x34, 0x56, 0x78,  # xid: 事务 ID (与 Discover 相同)
    0x00, 0x00,  # secs: 0
    0x80, 0x00,  # flags: 广播应答
    0x00, 0x00, 0x00, 0x00,  # ciaddr: 0.0.0.0
    0xC0, 0xA8, 0x01, 0x64,  # yiaddr: 192.168.1.100 (分配的 IP)
    0xC0, 0xA8, 0x01, 0x01,  # siaddr: 192.168.1.1 (DHCP 服务器)
    0x00, 0x00, 0x00, 0x00,  # giaddr: 0.0.0.0
    # chaddr: 客户端 MAC (与 Discover 相同)
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # sname: 服务端主机名 (64 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # file: 启动文件名 (128 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # magic cookie: DHCP 魔术字节
    0x63, 0x82, 0x53, 0x63,
    # DHCP 选项
    0x35, 0x01, 0x02,  # Option 53: DHCP Message Type = Offer (2)
    0x01, 0x04, 0xFF, 0xFF, 0xFF, 0x00,  # Option 1: Subnet Mask = 255.255.255.0
    0x03, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 3: Router = 192.168.1.1
    0x06, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 6: DNS Server = 192.168.1.1
    0x33, 0x04, 0x00, 0x01, 0x51, 0x80,  # Option 51: IP Address Lease Time = 86400 秒 (1 天)
    0x36, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 54: DHCP Server Identifier = 192.168.1.1
    0xff  # End Option
])

# 封装到 UDP（服务端端口 67，客户端端口 68）
use(offer) |> udp(sport=67, dport=68)
           |> ipv4(src="192.168.1.1", dst="255.255.255.255")

export:
- offer
