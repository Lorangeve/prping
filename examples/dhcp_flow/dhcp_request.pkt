# DHCP 流程步骤 3：DHCP Request（客户端确认请求 IP）
# 学习 DHCP 协议的地址分配流程
#
# DHCP Request 是客户端对 Offer 的响应：
#   - 客户端选择某个 Offer（可能有多个 DHCP 服务器）
#   - 广播 Request 请求，告知所有服务器它的选择
#   - 包含请求的 IP 地址和 DHCP 服务器标识
#
# 运行：sudo prping packet dhcp_request --raw --wait 2

# 构造 DHCP Request 报文
# op=1 (请求), htype=1 (以太网), hlen=6 (MAC), hops=0
# xid=0x12345678 (与 Discover/Offer 相同的事务 ID)
# flags=0x8000 (广播应答)
# ciaddr=0.0.0.0 (客户端仍无 IP)
# yiaddr=0.0.0.0 (等待确认)
# siaddr=0.0.0.0
# chaddr=客户端 MAC
request = raw(bytes=[
    0x01,  # op: 1 = BOOTREQUEST
    0x01,  # htype: 1 = 以太网
    0x06,  # hlen: 6 = MAC 地址长度
    0x00,  # hops: 0
    0x12, 0x34, 0x56, 0x78,  # xid: 事务 ID (与 Discover/Offer 相同)
    0x00, 0x00,  # secs: 0
    0x80, 0x00,  # flags: 广播应答
    0x00, 0x00, 0x00, 0x00,  # ciaddr: 0.0.0.0
    0x00, 0x00, 0x00, 0x00,  # yiaddr: 0.0.0.0 (等待确认)
    0x00, 0x00, 0x00, 0x00,  # siaddr: 0.0.0.0
    0x00, 0x00, 0x00, 0x00,  # giaddr: 0.0.0.0
    # chaddr: 客户端 MAC (与 Discover 相同)
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # sname: 服务端主机名 (64 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # file: 启动文件名 (128 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # magic cookie: DHCP 魔术字节
    0x63, 0x82, 0x53, 0x63,
    # DHCP 选项
    0x35, 0x01, 0x03,  # Option 53: DHCP Message Type = Request (3)
    0x32, 0x04, 0xC0, 0xA8, 0x01, 0x64,  # Option 50: Requested IP Address = 192.168.1.100
    0x36, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 54: DHCP Server Identifier = 192.168.1.1
    0xff  # End Option
])

# 封装到 UDP（客户端端口 68，服务端端口 67）
use(request) |> udp(sport=68, dport=67)
             |> ipv4(src="0.0.0.0", dst="255.255.255.255")

export:
- request
