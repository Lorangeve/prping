# 配方 demo：DHCP 四步流程（DORA：Discover → Offer → Request → Ack）
#
# 运行（在 examples/ 目录下，无扩展名参数自动定位到本目录同名 pktl）：
#   prping engine dhcp_flow                    # 概览
#   sudo prping packet dhcp_flow --raw --wait 2
#     （DHCP 需要 raw socket 发送（广播），需 root 权限）
#
# 学习要点：
#   - DHCP 协议用于自动分配 IP 地址和网络配置
#   - 基于 UDP 协议（客户端端口 68，服务端端口 67）
#   - 四步流程（DORA）：
#     1. Discover - 客户端广播发现 DHCP 服务器
#     2. Offer    - 服务端回复提供 IP 地址
#     3. Request  - 客户端确认请求 IP 地址
#     4. Ack      - 服务端确认分配 IP 地址
#   - 事务 ID (xid) 用于匹配同一 DHCP 会话的四个报文
#   - 客户端 MAC 地址在四个报文中保持一致
#
# DHCP 报文结构：
#   - 固定部分 (236 字节)：op/htype/hlen/hops/xid/secs/flags/ciaddr/yiaddr/siaddr/giaddr/chaddr/sname/file
#   - Magic Cookie：0x63825363（标识 DHCP 报文）
#   - 选项部分：可变长度，TLV 格式（Type-Length-Value）
#
# 常见 DHCP 选项：
#   Option | Name              | 描述
#   -------|-------------------|----------------------------------------
#   1      | Subnet Mask       | 子网掩码
#   3      | Router            | 默认网关
#   6      | DNS Server        | DNS 服务器地址
#   51     | Lease Time        | IP 地址租约时间（秒）
#   53     | Message Type      | DHCP 消息类型（1-8）
#   54     | Server Identifier | DHCP 服务器标识
#   55     | Parameter List    | 客户端请求的参数列表

recipe:
- packet: dhcp_discover.pkt   # 步骤 1：DHCP Discover（客户端广播发现）
- packet: dhcp_offer.pkt      # 步骤 2：DHCP Offer（服务端提供 IP）
- packet: dhcp_request.pkt    # 步骤 3：DHCP Request（客户端确认请求）
- packet: dhcp_ack.pkt        # 步骤 4：DHCP Ack（服务端确认分配）
