# 配方 demo：DNS 查询/响应流程（查询请求 → 查询响应）
#
# 运行（在 examples/ 目录下，无扩展名参数自动定位到本目录同名 pktl）：
#   prping engine dns_flow                    # 概览
#   prping packet dns_flow 127.0.0.1:53 --wait 1
#     （目标需有 DNS 服务监听，如本地 DNS 缓存服务器；
#       ip 默认 127.0.0.1 可注入 -p ip=...）
#
# 学习要点：
#   - DNS 协议用于域名解析（域名 → IP 地址）
#   - 基于 UDP 协议（端口 53），大数据量时使用 TCP
#   - 请求/响应模式：客户端发送查询，服务端返回结果
#   - 事务 ID 用于匹配请求和响应
#   - 递归查询（RD=1）：客户端要求服务端完成完整解析
#   - 迭代查询（RD=0）：客户端自行逐级查询
#
# DNS 报文结构：
#   - 头部 (12 字节)：
#     - ID (2B): 事务标识符
#     - Flags (2B): QR/Opcode/AA/TC/RD/RA/RCODE
#     - QDCOUNT (2B): 问题区记录数
#     - ANCOUNT (2B): 应答区记录数
#     - NSCOUNT (2B): 授权区记录数
#     - ARCOUNT (2B): 附加区记录数
#   - 问题区：QNAME + QTYPE + QCLASS
#   - 应答区：NAME + TYPE + CLASS + TTL + RDLENGTH + RDATA
#
# 常见 DNS 响应码 (RCODE)：
#   Code | Name          | 描述
#   -----|---------------|----------------------------------------
#   0    | No Error      | 无错误
#   1    | Format Error  | 报文格式错误
#   2    | Server Failure| 服务器失败
#   3    | Name Error    | 域名不存在（NXDOMAIN）
#   4    | Not Implemented| 未实现的查询类型
#   5    | Refused       | 查询被拒绝

global:
- name: dns_id    # DNS 事务 ID（用于匹配请求/响应）
  init: 0x5678

recipe:
- pkg: dns_query.pkt      # 步骤 1：DNS 查询请求
- pkg: dns_response.pkt   # 步骤 2：DNS 查询响应
