# tcp_handshake 步骤 2：TCP ACK（三次握手最后一步——握手完成）
# seq = 客户端初始 seq + 1（global("cseq") + 1，即服务端 SYN-ACK 的确认号）
# ack = 服务端初始 seq + 1（global("sseq") + 1）
# sport/dport 可注入：-p sport=40000,port=443；目标地址：-p ip=127.0.0.1
p = raw(bytes="")
ack_pkt = use(p) |> tcp(sport=params("sport", 40000), dport=params("port", 443),
                        seq=global("cseq", 0x1000) + 1, ack=global("sseq", 0x2000) + 1,
                        flags=ack())
                |> ipv4(src="127.0.0.1", dst=params("ip", "127.0.0.1"))
                |> eth(src_mac="00:11:22:33:44:55", dst_mac="66:77:88:99:aa:bb")

export:
- ack_pkt
