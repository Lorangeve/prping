# tcp_handshake 步骤 3：HTTP GET 数据（PSH|ACK，seq/ack 沿用步骤 2）
# 握手完成后同一连接的载荷包：http 层经 tcp 承载（PSH 表示数据应即时交付）
# sport/dport 可注入：-p sport=40000,port=443；目标地址：-p ip=127.0.0.1
get = http(start_line="GET / HTTP/1.1")
data = use(get) |> tcp(sport=params("sport", 40000), dport=params("port", 443),
                       seq=global("cseq", 0x1000) + 1, ack=global("sseq", 0x2000) + 1,
                       flags=bor(psh(), ack()))
              |> ipv4(src="127.0.0.1", dst=params("ip", "127.0.0.1"))
              |> eth(src_mac="00:11:22:33:44:55", dst_mac="66:77:88:99:aa:bb")

export:
- data
