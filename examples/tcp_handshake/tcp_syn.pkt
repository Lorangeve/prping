# tcp_handshake 步骤 1：TCP SYN（三次握手第一步）
# 客户端初始 seq 来自配方全局 cseq（独立 packet 时用默认 0x1000）
# sport/dport 可注入：-p sport=40000,port=443；目标地址：-p ip=127.0.0.1
#
# sniffer 段匹配 SYN-ACK（回包 sport/dport 与发包互换；flags 为 SYN|ACK）——
# 仅配合 --wait（Windows Npcap 可收；Linux raw 回包 socket 只收 ICMP，收不到 TCP）。
# 注意：元件名勿用 syn/ack（位常量短名会被遮蔽，见 eng_lib/bytes.pkt）。
p = raw(bytes="")
syn_pkt = use(p) |> tcp(sport=params("sport", 40000), dport=params("port", 443),
                        seq=global("cseq", 0x1000), flags=syn())
                |> ipv4(src="127.0.0.1", dst=params("ip", "127.0.0.1"))
                |> eth(src_mac="00:11:22:33:44:55", dst_mac="66:77:88:99:aa:bb")

sniffer:
  - match tcp(sport=dport, dport=sport, flags=bor(syn(), ack()))

export:
- syn_pkt
