# DHCP 流程步骤 4：DHCP Ack（服务端确认分配）——dhcp_mock server 配方第 2 组
# listen 命中（Request）后的触发发包步骤（由 server.pktl 编排，不单独跑）。
#
# DHCP Ack 是服务端对 Request 的最终确认：
#   - 确认 IP 地址分配（yiaddr 与 Offer 一致）
#   - 包含完整的网络配置信息（掩码/网关/DNS/租约）
#   - 客户端收到后即可正式使用分配的 IP（真实客户端还会用 ARP 探测地址冲突）
#
# mock 说明与 dhcp_offer.pkt 相同：没有 dhcp proto 层 → xid/chaddr 固定、
# yiaddr 等预置在数组里；单播回包替代真实广播；载荷假地址（192.168.1.x）
# 与外层回环封装（global 提取）各自独立。
#
# 字段来源（server.pktl 第 2 组 listen 步骤的 extract，与第 1 组相同）：
#   global.cip   = reply.ipv4.src  —— 客户端 IP
#   global.cport = reply.udp.sport —— 客户端端口（:68）
#   global.sip   = reply.ipv4.dst  —— 本机 IP
# global(...) 的第二个参数是缺省值：配方里由 extract 覆盖；单跑本文件时落到
# 回环缺省，便于独立演示与 engine 校验。
ack = raw(bytes=[
    0x02,  # op: 2 = BOOTREPLY
    0x01,  # htype: 1 = 以太网
    0x06,  # hlen: 6 = MAC 地址长度
    0x00,  # hops: 0
    0x12, 0x34, 0x56, 0x78,  # xid: 事务 ID (与 Request 相同；mock 固定值)
    0x00, 0x00,  # secs: 0
    0x80, 0x00,  # flags: 广播应答
    0x00, 0x00, 0x00, 0x00,  # ciaddr: 0.0.0.0
    0xC0, 0xA8, 0x01, 0x64,  # yiaddr: 192.168.1.100 (确认分配的 IP)
    0xC0, 0xA8, 0x01, 0x01,  # siaddr: 192.168.1.1 (DHCP 服务器)
    0x00, 0x00, 0x00, 0x00,  # giaddr: 0.0.0.0
    # chaddr: 客户端 MAC (与 Request 相同)
    0x00, 0x11, 0x22, 0x33, 0x44, 0x55,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # sname: 服务端主机名 (64 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # file: 启动文件名 (128 字节)
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
    # magic cookie: DHCP 魔术字节 0x63825363
    0x63, 0x82, 0x53, 0x63,
    # DHCP 选项（TLV）
    0x35, 0x01, 0x05,  # Option 53: DHCP Message Type = Ack (5)
    0x01, 0x04, 0xFF, 0xFF, 0xFF, 0x00,  # Option 1: Subnet Mask = 255.255.255.0
    0x03, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 3: Router = 192.168.1.1
    0x06, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 6: DNS Server = 192.168.1.1
    0x33, 0x04, 0x00, 0x01, 0x51, 0x80,  # Option 51: IP Address Lease Time = 86400 秒 (1 天)
    0x36, 0x04, 0xC0, 0xA8, 0x01, 0x01,  # Option 54: DHCP Server Identifier = 192.168.1.1
    0xff  # End Option
])

# 封装：UDP 67→global.cport + IP global.sip→global.cip，单播（同 Offer）。
# 不设 sniffer——server 的触发发包步骤不等应答。
use(ack) |> udp(sport=67, dport=global("cport", 68)) |> ipv4(src=global("sip", "127.0.0.1"), dst=global("cip", "127.0.0.1"))
