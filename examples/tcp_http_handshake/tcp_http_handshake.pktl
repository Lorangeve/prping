# 配方：TCP 三次握手 + HTTP GET（完整应用层交互）
#
# 运行（在 examples/ 目录下，无扩展名参数自动定位到本目录同名 pktl）：
#   prping engine tcp_http_handshake               # 概览
#   sudo prping packet tcp_http_handshake 127.0.0.1:80 --raw --wait 3 -p port=80
#     （--raw 发原始 TCP 包需 root/cap_net_raw；目标需有 HTTP 服务；
#       Linux raw 回包 socket 只能收 ICMP 收不到 TCP，需 Windows Npcap 或配合 --wait）
#
# 演示点（对标 Scapy 的 sr1 行为）：
#   - 三步流程 = 三次握手 + HTTP GET（Scapy 默认自动处理，这里手动拆解）
#   - 步骤 1：SYN → 等待 SYN-ACK，extract 服务端 seq/ack 到 global
#   - 步骤 2：ACK（握手完成，用步骤 1 提取的 seq/ack 计算）
#   - 步骤 3：HTTP GET（PSH|ACK），等待 HTTP 响应
#   - seq/ack 链：global 自动从回包提取（reply.tcp.seq/ack），无需硬编码
#
# 对比 Scapy：
#   Scapy: sr1(IP(dst="x")/TCP(dport=80)/"GET / HTTP/1.1\r\n")  # 自动握手
#   prping: prping packet tcp_http_handshake x:80 --raw --wait 3  # 手动握手配方
#
# 注意：Linux raw 模式收不到 TCP 回包（只能收 ICMP），需 Windows Npcap 或
# 使用 payload 模式（去掉 --raw）让 OS 处理握手。
global:
- name: cseq      # 客户端初始序号（步骤 1 SYN 的 seq）
  init: 0x1000
- name: sseq      # 服务端初始序号（从 SYN-ACK 提取）
  init: 0

recipe:
- packet: syn.pkt
  wait: 3
  extract:
  - name: cseq
    from: reply.tcp.ack     # SYN-ACK 的 ack 号 = 客户端 seq + 1
    as: int
  - name: sseq
    from: reply.tcp.seq     # SYN-ACK 的 seq 号
    as: int
- packet: ack.pkt
  wait: 0                   # ACK 不需要等待应答
- packet: http_get.pkt
  wait: 3
