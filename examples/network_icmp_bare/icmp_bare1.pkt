# network_icmp_bare 步骤 1：ICMPv4/v6 echo request（裸 IP，id 随机）
# 回包校验：echo reply 且 id/seq 与发包一致；目标地址可注入：-p ip=127.0.0.1（默认回环）
payload = raw(bytes="prping icmp probe")

full4 = use(payload) |> icmp(type=8, id=rand16(), seq=1)
                    |> ipv4(src=params("src", "0.0.0.0"), dst=params("ip", "127.0.0.1"))
full6 = use(payload) |> icmp(type=128, id=rand16(), seq=1)
                    |> ipv6(src=params("src6", "::"), dst=params("ip6", "::1"))

# 回包校验（--wait）：回包必须是 ICMP 且 id/seq 与发包一致（v4/v6 通用）
sniffer:
  - match icmp(id=id, seq=seq)

export:
- full4
- full6
