# 链路层 demo：原始以太网帧（raw / hex 载荷 + 自定义 ethertype）
# 运行：prping --eng examples/link_raw_eth.pkt
#   prping --pkg examples/link_raw_eth.pkt HOST:PORT --raw

text_payload = raw(bytes="hello from prping")
hex_payload  = hex("de ad be ef 00 01 02 03")

export:
- text
- hex_frame

text = use(text_payload) |> eth(src_mac="00:11:22:33:44:55", dst_mac="66:77:88:99:aa:bb", ethertype=0x1234)
hex_frame = use(hex_payload) |> eth(src_mac="00:11:22:33:44:55", dst_mac="ff:ff:ff:ff:ff:ff", ethertype=0x88b5)
