# UDP 门禁 mock · 爆破客户端配方（client.pktl）：对 127.0.0.1:55353 的门禁逐个
# 试候选 PIN。同一个 attempt.pkt 反复出现，靠步骤级 params: 覆盖候选——
# 配方没有循环结构（每步显式可读，这正是 .pktl 的设计取向），5 个候选就是 5 步。
#
# 步骤结构（前 4 步故意错误、正确的放最后，让 ✗/✓ 对比一目了然）：
#   params: code=PIN-XXXX  本步候选（attempt.pkt 的 qname 标签取用；纯数字会被
#                          params 自动转成整数——见 attempt.pkt 注释）
#   delay: 0.3             步前等待——真实爆破应给服务端喘息（本示例刻意低速）
#   wait: 1                发后等应答（sniffer：id 一致 + 应答位）；错误候选无应答
#                          → 1s 超时
#   on_error: continue     超时失败不中止配方（默认 stop 会一把剪断后续尝试）
#   最后一步 wait: 2       命中步：收到 GRANT 应答 → ✓ reply matched: ...
#
# 运行（先在另一终端起 server.pktl）：
#   prping packet examples/brute_pin/client.pktl 127.0.0.1:55353
# 目标注入：-p ip= / -p port= （或直接给 CLI 目标参数，优先级最高）
#
# 候选很多时：本文件没有循环，长候选表用「单步配方 + 外层 shell 循环」更合适：
#   for c in 0000 1111 4242; do
#     prping packet examples/brute_pin/attempt.pkt 127.0.0.1:55353 -p code=PIN-$c --wait 1 || true
#   done
# （attempt.pkt 也能脱离配方单独跑；--wait 1 = 发一个候选等 1s）
recipe:
- packet: attempt.pkt
  params: code=PIN-0000
  wait: 1
  delay: 0.3
  on_error: continue
- packet: attempt.pkt
  params: code=PIN-1234
  wait: 1
  delay: 0.3
  on_error: continue
- packet: attempt.pkt
  params: code=PIN-8888
  wait: 1
  delay: 0.3
  on_error: continue
- packet: attempt.pkt
  params: code=PIN-9999
  wait: 1
  delay: 0.3
  on_error: continue
- packet: attempt.pkt
  params: code=PIN-4242
  wait: 2
