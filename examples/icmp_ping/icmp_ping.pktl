# 配方 demo：ICMP Ping 流程（请求 → 应答）
#
# 运行（在 examples/ 目录下，无扩展名参数自动定位到本目录同名 pktl）：
#   prping engine icmp_ping                    # 概览
#   sudo prping packet icmp_ping 127.0.0.1 --raw --wait 1
#     （--raw 发原始 ICMP 包需 root/cap_net_raw；ICMP 无端口，用裸 HOST 即可；
#       目标需支持 ICMP 回显，如 ping 本机 127.0.0.1；ip 可注入 -p ip=...）
#
# 学习要点：
#   - ICMP 协议结构：Type(1B) + Code(1B) + Checksum(2B) + ID(2B) + Seq(2B)
#   - Echo Request/Reply 匹配机制：相同 id 和 seq
#   - ICMP 是网络层协议，封装在 IPv4 中（proto=1）
#   - ping 命令的底层实现原理
#
# ICMP 消息类型速查：
#   Type | Name                    | 描述
#   -----|------------------------|----------------------------------------
#   0    | Echo Reply             | ping 应答
#   3    | Destination Unreachable | 目标不可达（code 细分原因）
#   8    | Echo Request           | ping 请求
#   11   | Time Exceeded          | TTL 超时（traceroute 使用）

global:
- name: seq      # 序列号（每步递增，用于匹配请求/应答）
  init: 1
- name: id       # 标识符（同一 ping 会话使用相同 id）
  init: 0

recipe:
- packet: icmp_request.pkt   # 步骤 1：ICMP Echo Request
- packet: icmp_reply.pkt     # 步骤 2：ICMP Echo Reply（模拟应答）
