# HTTP mock · 服务端配方（server.pktl）：一个 pktl 就是一个 HTTP 服务端。
# `serve:` 阶段（阻塞至收工）——**单一 serve 阶段双规则分派**（GET / POST 共用
# 一条链路层监听会话，按声明顺序逐个匹配、先命中先服务；链路层多规则由
# `listen_raw_dispatch` 单抓包循环驱动，规则间无重绑间隙）：每规则命中 →
# extract 写 global → 该规则 handler 触发发包；`max: 2` = GET+POST 各服务一轮。
#
# 规则监听 listen_*.pkt——包内无 udp/tcp 传输层 → 自动选**链路层监听**完整帧
# （需 root），sniffer 匹配 http(method=...)（GET/POST 帧 dport=80 触发 http
# 反解快速分派，见 listen_*.pkt 注释）；命中后 extract 匹配帧字段写 global：
# 客户端端口/序列号 + 双向 IP。handler 触发发包 resp_*.pkt（raw: true 链路层
# 发送）——用 global 构造 200 OK 响应：端口互换（sport=80 → dport=r_sport）、
# ack = r_seq + 请求字节数（GET 90 / POST 132——TCP 确认号语义的教学点）、
# seq 固定 0x2000。
#
# 内核 RST 副作用（为什么无碍）：mock 不是真 TCP 栈——不握手、不维护连接状态。
# 本机内核看到发往"无监听端口"的帧会回 RST，但 RST 帧载荷为空，反解不出
# http 层，两条规则的 sniffer（http(method=...)）永不误触发；client 的 sniffer
# 也用 flags="psh,ack" 排除 RST（flags="rst"）——详见 README「内核 RST 副作用」。
#
# 运行（需 root；AF_PACKET/Npcap 链路层监听）：
#   sudo prping packet examples/http_mock/server.pktl
# 客户端（另一终端）：
#   sudo prping packet examples/http_mock/client.pktl
global:
- r_sport    # 请求方源端口（→ 响应 dport）
- r_seq      # 请求方 TCP 序列号（→ 响应 ack = r_seq + 请求字节数）
- r_src_ip   # 请求方 IP（reply.ipv4.src → 响应 dst）
- r_dst_ip   # 本机 IP（reply.ipv4.dst → 响应 src）

recipe:
# ── GET / POST 双规则分派：共用一条监听会话，先命中先服务 ──
- serve:
  max: 2
  rules:
  - packet: listen_get.pkt
    extract:
    - name: r_sport
      from: reply.tcp.sport
      as: int
    - name: r_seq
      from: reply.tcp.seq
      as: int
    - name: r_src_ip
      from: reply.ipv4.src
      as: str
    - name: r_dst_ip
      from: reply.ipv4.dst
      as: str
    handler:
    - packet: resp_get.pkt
      raw: true
  - packet: listen_post.pkt
    extract:
    - name: r_sport
      from: reply.tcp.sport
      as: int
    - name: r_seq
      from: reply.tcp.seq
      as: int
    - name: r_src_ip
      from: reply.ipv4.src
      as: str
    - name: r_dst_ip
      from: reply.ipv4.dst
      as: str
    handler:
    - packet: resp_post.pkt
      raw: true
