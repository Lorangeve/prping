# server 配方 · 第 2 阶段 handler 步骤（触发发包）：对 HTTP POST 请求回 200 OK。
# 与 resp_get.pkt 完全同构，唯一差别是 ack 的推进量：
#   ack = r_seq + 132（POST 请求字节数：请求行 22 + 头行 32/24/20 + 空行 2
#   + JSON body 32，逐行算式见 http_post.pkt 注释）= 0x1000 + 132 = 0x1084。
# TCP 的确认号是"字节流计数器"——POST 载荷比 GET 长 42 字节，ack 就多推进 42，
# client 的 sniffer 用 0x1084 校验，两条请求的确认号差异本身就是教学点。
resp = http(start_line="HTTP/1.1 200 OK",
            headers=["Content-Type: text/html", "Content-Length: 31", "Connection: keep-alive"],
            body="<html><body>Hello</body></html>")
use(resp) |> tcp(sport=params("port", 80), dport=global("r_sport"),
                 seq=0x2000, ack=global("r_seq") + 132, flags=bor(psh(), ack()))
          |> ipv4(src=global("r_dst_ip"), dst=global("r_src_ip"))
          |> eth(src_mac="00:00:00:00:00:00", dst_mac="00:00:00:00:00:00")
