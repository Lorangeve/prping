# 配方 demo：两步 UDP 流程（DNS 查询 → VNC 原始载荷）
#
# 运行（在 examples/ 目录下，无扩展名参数自动定位到本目录同名 pktl）：
#   prping engine transport_udp                    # 概览
#   prping packet transport_udp 127.0.0.1:53 --wait 1
#     （发 UDP 载荷，目标需回显；ip 默认 127.0.0.1 可注入 -p ip=...）
#
# 演示点：
#   - 步骤 1：DNS 查询（应用层 dns → udp → ipv4 → eth）
#   - 步骤 2：VNC 握手横幅（raw 字符串载荷，同一协议栈）
recipe:
- packet: udp_dns.pkt
- packet: udp_vnc.pkt
