# 链路层 demo：ARP 请求/应答（无上层载荷，直接构造以太网帧）
# 运行：prping --eng examples/link_arp.pkt
#   prping --pkg examples/link_arp.pkt HOST:PORT --raw   （--raw 发完整帧）

req = arp(op="request", sha="00:11:22:33:44:55", spa="192.168.1.1", tha="00:00:00:00:00:00", tpa="192.168.1.2")
rpl = arp(op="reply", sha="00:11:22:33:44:55", spa="192.168.1.2", tha="00:11:22:33:44:55", tpa="192.168.1.1")

export:
- req
- rpl

# 默认导出：ARP 请求 + 广播目的（ethertype 由 arp 层自动推导 0x0806）
use(req) |> eth(src_mac="00:11:22:33:44:55", dst_mac="ff:ff:ff:ff:ff:ff")
