# ICMP echo 服务端配方（server.pktl）：监听触发 + extract 取值 + 触发发包。
#
# 步骤 1：`wait:`（无值 = 持续监听）——本包无 udp/tcp 传输层 → 自动链路层监听
#         完整帧，匹配 ICMP echo request（type=8），命中后 extract 匹配帧字段写
#         global：id/seq/载荷回显 + 请求方 IP（reply.ipv4.src）/本机 IP（reply.ipv4.dst）。
# 步骤 2：触发发包——reply.pkt 用 global 构造 echo reply 发回请求方（raw: true，
#         裸 IP 外层走内核 IP 栈路由）。
#
# 一个 wait 步骤服务一个请求：要连续服务更多请求，把 listen+reply 步骤包进
# `loop:` 块（见 examples/dns_loop_server/ 的无限循环写法），或像
# examples/icmp_mock/server.pktl 那样手写多组。
#
# 运行（需 root/管理员；Linux AF_PACKET / macOS·Windows libpcap·Npcap）：
#   sudo prping packet examples/icmp_echo_server/server.pktl
# 客户端（另一终端）：
#   sudo prping packet --raw --wait 2 examples/icmp_echo_server/client.pkt 127.0.0.1
global:
- r_id
- r_seq
- r_payload
- r_src_ip
- r_dst_ip

recipe:
- packet: listen.pkt
  wait:
  extract:
  - name: r_id
    from: reply.icmp.id
    as: int
  - name: r_seq
    from: reply.icmp.seq
    as: int
  - name: r_payload
    from: reply.icmp.payload
    as: bytes
  - name: r_src_ip
    from: reply.ipv4.src
    as: str
  - name: r_dst_ip
    from: reply.ipv4.dst
    as: str
- packet: reply.pkt
  raw: true
