# ICMP echo 请求·客户端（packet --raw --wait SECS）
#
# 运行：sudo prping packet --raw --wait 2 client.pkt 127.0.0.1
# 流程：发 ICMP echo request（id=0x1234, seq=1）→ 服务端回 echo reply →
#       sniffer 校验（type=0、id/seq 与发包一致）。
p = raw(bytes="hello ping")
use(p) |> icmp(type=8, id=0x1234, seq=1) |> ipv4(dst=params("ip", "127.0.0.1"))

sniffer:
  - match icmp(type=0, id=id, seq=seq)
