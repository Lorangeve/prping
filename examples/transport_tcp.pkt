# 传输层 demo：TCP（SYN 探测 / PSH+ACK 数据 两个变体）
# 运行：prping --eng examples/transport_tcp.pkt
#   prping --pkg examples/transport_tcp.pkt HOST:PORT   （发 HTTP 载荷）
#
# 注意：headers.tcp 无 mss 选项（DSL 无条件分支，MSS 需 hex/raw 直喂）。

http_get = http(method="GET", path="/")

syn   = use(http_get) |> tcp(sport=40000, dport=443, flags="syn")
data  = use(http_get) |> tcp(sport=40001, dport=443, seq=1, flags="psh,ack", window=65535)

export:
- syn
- data
